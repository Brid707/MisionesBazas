<Window x:Class="MisionesBazas.view.ForgotPassword"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MisionesBazas.view"
      xmlns:language="clr-namespace:MisionesBazas.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="480" d:DesignWidth="820"
      Height="480" Width="820"
      Title="ForgotPassword" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#6A0B0B">

    <Grid>
        <Border x:Name="MainBorder" BorderThickness="3" BorderBrush="#000" Padding="12" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="CloseButton" Content="✕" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#2a0000" Foreground="Black" FontWeight="Bold" FontSize="18" BorderThickness="2" BorderBrush="#000"
                        Click="CloseButton_Click" />

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <TextBlock Text="{x:Static language:Resources.ForgotPassword_Title}" FontFamily="Impact" FontSize="32" Foreground="#FFF36B" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
                    <StackPanel>
                        <TextBlock Text="{x:Static language:Resources.ForgotPassword_Information}" Foreground="#000" FontSize="16" TextAlignment="Center" Margin="0,0,0,18" />

                        <TextBox x:Name="EmailTextBox" Width="640" Height="48" Background="White" BorderBrush="#0b0b0b" BorderThickness="4" Padding="8" FontSize="16" />

                        <Button x:Name="SendButton" Content="{x:Static language:Resources.ForgotPassword_Button}" Width="200" Height="44" Background="#FFF36B" Foreground="#0b0b0b" FontSize="18" FontWeight="SemiBold" BorderThickness="0" Margin="0,24,0,0" Click="SendButton_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Window>
