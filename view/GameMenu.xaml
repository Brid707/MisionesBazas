<Page x:Class="MisionesBazas.GameMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:MisionesBazas.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="GameMenu">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#4A0003" Offset="0.0" />
                <GradientStop Color="#700006" Offset="0.3" />
                <GradientStop Color="#8A0B0B" Offset="0.8" />
                <GradientStop Color="#910000" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Button x:Name="BtnProfile" Width="64" Height="64" Margin="40,30,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="BtnProfile_Click"
                    ToolTip="{x:Static language:Resources.GameMenu_Profile}">
                <Grid Width="56" Height="56">
                    <Ellipse Fill="Black" Width="56" Height="56" />
                    <Ellipse Fill="White" Width="18" Height="18" Margin="0,10,0,0" VerticalAlignment="Top" />
                    <Path Fill="White" Data="M 12 46 C 12 34 20 30 28 30 C 36 30 44 34 44 46 Z" />
                </Grid>
            </Button>

            <Button x:Name="BtnTrophy" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,120,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTrophy_Click" ToolTip="Tabla de puntuaciones">
                <TextBlock Text="🏆" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LblGameTitle"
                           Text="{x:Static language:Resources.GameMenu_Title}"
                           Foreground="#FFF36B"
                           FontFamily="Impact, Arial Black, 'Segoe UI'"
                           FontWeight="Bold"
                           FontSize="78"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,44" />

                <StackPanel HorizontalAlignment="Center" Width="440">
                    <Button x:Name="btnCrearSala"
                            Content="{x:Static language:Resources.GameMenu_CreateRoom}"
                            Width="440" Height="72"
                            Background="#FFF36B" Foreground="Black"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0" Margin="0,0,0,24"
                            Click="BtnCrearSala_Click" />

                    <Button x:Name="btnUnirseSala"
                            Content="{x:Static language:Resources.GameMenu_JoinLobby}"
                            Width="440" Height="72"
                            Background="#FFF36B" Foreground="Black"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0" Margin="0,0,0,24"
                            Click="BtnUnirseSala_Click" />

                    <Button x:Name="btnComoJugar"
                            Content="{x:Static language:Resources.GameMenu_HowToPlay}"
                            Width="440" Height="72"
                            Background="#FFF36B" Foreground="Black"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="BtnComoJugar_Click" />

                    <Button x:Name="btnSalir"
                            Content="{x:Static language:Resources.GameMenu_SignOut}"
                            Width="440" Height="72"
                            Background="#d22020" Foreground="White"
                            FontSize="18" FontWeight="SemiBold"
                            BorderThickness="2" Margin="0,24,0,0"
                            Click="BtnSalir_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="3,0,0,0" Background="#8A0000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,3">
                    <Button x:Name="BtnFriends" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnFriends_Click"
                            ToolTip="{x:Static language:Resources.GameMenu_Friends}">
                        <Canvas Width="70" Height="50">
                            <Ellipse Canvas.Left="16" Canvas.Top="0" Width="22" Height="22"
                                     Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Path Data="M 6 48 C 6 36 14 30 27 30 C 40 30 48 36 48 48"
                                  Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Ellipse Canvas.Left="38" Canvas.Top="6" Width="18" Height="18"
                                     Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Path Data="M 44 32 C 48 31 52 32 56 36 C 60 40 60 46 60 48"
                                  Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                        </Canvas>
                    </Button>
                </Border>

                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,0,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnMessages" Grid.Column="0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnMessages_Click"
                                ToolTip="{x:Static language:Resources.GameMenu_Messages}">
                            <Canvas Width="48" Height="36">
                                <Rectangle Width="46" Height="32" Canvas.Left="1" Canvas.Top="2"
                                           Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                                <Path Data="M 2 3 L 24 20 L 46 3" Stroke="Black"
                                      StrokeThickness="3.5" Fill="Transparent" />
                            </Canvas>
                        </Button>

                        <Button x:Name="BtnAddFriend" Grid.Column="1" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnAddFriend_Click"
                                ToolTip="{x:Static language:Resources.GameMenu_AddFriend}">
                            <Canvas Width="48" Height="36">
                                <Ellipse Canvas.Left="12" Canvas.Top="0" Width="16" Height="16"
                                         Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                                <Path Data="M 2 34 C 2 24 9 20 20 20 C 31 20 38 24 38 34"
                                      Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                                <Line X1="41" Y1="14" X2="41" Y2="24"
                                      Stroke="Black" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="36" Y1="19" X2="46" Y2="19"
                                      Stroke="Black" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FriendsListPanel" Margin="10">
                            <Border Background="#680000" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Usuario 1" Foreground="White" FontWeight="Bold" FontSize="14" />
                                    <TextBlock x:Name="lblEnLinea" Text="{x:Static language:Resources.FriendsBar_Online}" Foreground="#66FF66" FontSize="12" Margin="0,2,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnVerPerfil" Content="{x:Static language:Resources.FriendsBar_ViewProfile}" Background="#FFF36B" Foreground="Black" FontSize="10" Padding="6,2" Margin="0,0,4,0" Click="BtnVerPerfil_Click" />
                                        <Button x:Name="btnEliminarAmigo" Content="{x:Static language:Resources.FriendsBar_DeleteFriend}" Background="#EA4444" Foreground="White" FontSize="10" Padding="6,2" Click="BtnEliminarAmigo_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
