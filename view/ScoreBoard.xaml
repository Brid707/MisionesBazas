<Window x:Class="MisionesBazas.view.ScoreBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:MisionesBazas.Properties.Langs"
        mc:Ignorable="d"
        Title="ScoreBoard" Height="380" Width="780" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#7a0000" />
            <Setter Property="Foreground" Value="#000" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="#000" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#000" BorderThickness="3" CornerRadius="4" Background="Transparent" Padding="8">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8B0000" Offset="0" />
                    <GradientStop Color="#d22020" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="{x:Static language:Resources.ScoreBoard_Title}" FontFamily="Impact" FontSize="32" Foreground="#FFF36B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />

                    <Button Grid.Column="2" x:Name="BtnClose" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2a0000" BorderBrush="#000" BorderThickness="2" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="18" Foreground="#000" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Width="740">
                    <DataGrid x:Name="ScoresDataGrid"
                              ItemsSource="{Binding Scores}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              RowHeight="60"
                              Height="340"
                              GridLinesVisibility="All"
                              BorderBrush="#000"
                              BorderThickness="2"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              HorizontalGridLinesBrush="#000"
                              VerticalGridLinesBrush="#000"
                              Background="#8b0000"
                              Foreground="#000"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static language:Resources.ScoreBoard_Position}" Binding="{Binding Position}" Width="84" ElementStyle="{StaticResource CenteredCellStyle}" />

                            <DataGridTemplateColumn Header="{x:Static language:Resources.ScoreBoard_PlayerProfile}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Ellipse Width="44" Height="44" Fill="#000" Stroke="#fff" StrokeThickness="6" />
                                            <TextBlock Text="{Binding Username}" VerticalAlignment="Center" Margin="8,0" Foreground="#000" FontSize="16" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{x:Static language:Resources.ScoreBoard_Missions}" Binding="{Binding MissionsCompleted}" Width="180" ElementStyle="{StaticResource CenteredCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</Window>