<Page x:Class="MisionesBazas.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
	  xmlns:language="clr-namespace:MisionesBazas.Properties.Langs"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="LoginPage">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*" />
            <ColumnDefinition Width="0.55*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7a0006" Offset="0" />
                    <GradientStop Color="#b90a0a" Offset="0.5" />
                    <GradientStop Color="#c60b0b" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,120" Width="500">
                    <TextBlock x:Name="lblTitulo" Text="{x:Static language:Resources.Login_Title}" Foreground="#FFF36B" FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontWeight="Bold" FontSize="72" TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,6" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BtnBack" Content="←" Width="40" Height="40" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BtnBack_Click" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock x:Name="lblTituloInicioSesion" Text="{x:Static language:Resources.Login_LoginTitle}" Foreground="#FFF36B" FontSize="32" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,18" />

                <TextBlock Text="{x:Static language:Resources.Login_Email}" Foreground="White" FontSize="14" Margin="6,0,0,6" />
                <TextBox x:Name="txtCorreo" Height="56" FontSize="18" Padding="12" Margin="0,0,0,12" />

                <TextBlock Text="{x:Static language:Resources.Login_Password}" Foreground="White" FontSize="14" Margin="6,0,0,6" />
                <PasswordBox x:Name="txtContraseña" Height="56" FontSize="18" Padding="12" Margin="0,0,0,8" />

                <Button x:Name="btnRecuperarContraseña" Content="{x:Static language:Resources.Login_ForgotPassword}" Height="32" Width="220" Background="Transparent" Foreground="#FFF36B" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,12" Click="BtnRecuperarContraseña_Click" />

                <Button x:Name="btnEntrar" Content="{x:Static language:Resources.Login_Enter}" Height="64" Width="220" Background="#d49b2a" Foreground="Black" FontSize="22" FontWeight="Bold" Click="BtnEntrar_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
