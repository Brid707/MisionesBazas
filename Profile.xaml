<Page x:Class="MisionesBazas.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="Profile">

    <Grid Background="#94040D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Cards decoration strip -->
        <Image Grid.Column="0"
               Source="ProfileCards.png"
               Stretch="Fill"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Width="150" />

        <!-- RIGHT: Profile Content Area -->
        <Grid Grid.Column="1" Margin="30,24,40,30">
            <!-- Top Right: Close Button -->
            <Button x:Name="BtnClose"
                    Width="50" Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Grid Width="44" Height="44">
                    <Ellipse Fill="Black" Width="44" Height="44" />
                    <Path Stroke="#94040D"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 14 14 L 30 30 M 30 14 L 14 30" />
                </Grid>
            </Button>

            <!-- Main Profile Data Stack -->
            <StackPanel Margin="30,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Avatar & Username -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,32">
                    <Grid Width="96" Height="96">
                        <Ellipse Fill="Black" Width="96" Height="96" />
                        <Ellipse Fill="White" Width="30" Height="30" Margin="0,18,0,0" VerticalAlignment="Top" />
                        <Path Fill="White" Data="M 20 78 C 20 58 34 52 48 52 C 62 52 76 58 76 78 Z" />
                    </Grid>

                    <TextBlock x:Name="lblNombreUsuario"
                               Text="xX_Samuel_Xx"
                               FontSize="42"
                               FontWeight="Normal"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="28,0,0,0" />
                </StackPanel>

                <!-- Stats Row: Account Creation Date & Missions Completed -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,80,0">
                        <Label x:Name="lblCreacionCuenta"
                               Content="{Binding Source={StaticResource Loc}, Path=[Profile.AccountCreation]}"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="Black"
                               Padding="0"
                               VerticalAlignment="Center" />
                        <Label x:Name="lblFecha"
                               Content="{Binding Source={StaticResource Loc}, Path=[Profile.Date]}"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="Black"
                               Padding="0"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lblMisiones"
                               Content="{Binding Source={StaticResource Loc}, Path=[Profile.Missions]}"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="Black"
                               Padding="0"
                               VerticalAlignment="Center" />
                        <Label x:Name="lblMisionesValor"
                               Content="0"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="Black"
                               Padding="0"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <!-- Biography Section -->
                <Label x:Name="lblBiografia"
                       Content="{Binding Source={StaticResource Loc}, Path=[Profile.Biography]}"
                       FontSize="24"
                       FontWeight="Normal"
                       Foreground="Black"
                       Padding="0"
                       Margin="0,0,0,10" />

                <TextBox x:Name="txtBiografia"
                         Width="660"
                         Height="160"
                         Background="White"
                         Foreground="Black"
                         FontSize="20"
                         Padding="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,24" />

                <!-- Email Section -->
                <StackPanel Orientation="Horizontal">
                    <Label x:Name="lblCorreo"
                           Content="{Binding Source={StaticResource Loc}, Path=[Profile.Email]}"
                           FontSize="24"
                           FontWeight="Normal"
                           Foreground="Black"
                           Padding="0"
                           VerticalAlignment="Center" />
                    <Label x:Name="lblCorreoValor"
                           Content="correo@correo.com"
                           FontSize="24"
                           FontWeight="Normal"
                           Foreground="Black"
                           Padding="0"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
