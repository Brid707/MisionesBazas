            <endpoint address="net.tcp://localhost:8090/FriendsRequestService"
                binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IFriendsRequestService"
                contract="IFriendsRequestService.IFriendsRequestService" name="NetTcpBinding_IFriendsRequestService">
                <identity>
                    <userPrincipalName value="LAPTOP-I1BO0IGC\oscar" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>