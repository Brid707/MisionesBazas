<Window x:Class="View.Views.ScoreBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="ScoreBoard" Height="380" Width="780"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource BrushTransparent}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontFamily" Value="{x:Static styles:FontTypography.BodyFontFamily}" />
            <Setter Property="FontSize" Value="{x:Static styles:FontTypography.FormLabelFontSize}" />
        </Style>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{StaticResource BrushLobbyContainerBackground}" />
            <Setter Property="Foreground"
                    Value="{StaticResource BrushTextDark}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource BrushTextDark}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontFamily" Value="{x:Static styles:FontTypography.BodyFontFamily}" />
            <Setter Property="FontSize" Value="{x:Static styles:FontTypography.FormLabelFontSize}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushTextDark}"
            BorderThickness="3" CornerRadius="4" Background="{StaticResource BrushTransparent}" Padding="8">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource ColorModalAccentGradientStart}"
                                  Offset="0" />
                    <GradientStop Color="{StaticResource ColorModalAccentGradientEnd}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1"
                               Text="{x:Static language:Resources.ScoreBoard_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{StaticResource BrushGoldAccent}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="620" />

                    <Button Grid.Column="2" x:Name="CloseButton" Width="44" Height="44"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource BrushBurgundyDark}"
                            BorderBrush="{StaticResource BrushTextDark}"
                            BorderThickness="2"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="✕"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{StaticResource BrushTextDark}"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Width="740">
                    <DataGrid x:Name="ScoresDataGrid"
                              ItemsSource="{Binding Rankings}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              RowHeight="60"
                              Height="340"
                              GridLinesVisibility="All"
                              BorderBrush="{StaticResource BrushTextDark}"
                              BorderThickness="2"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              HorizontalGridLinesBrush="{StaticResource BrushTextDark}"
                              VerticalGridLinesBrush="{StaticResource BrushTextDark}"
                              Background="{StaticResource BrushInputFieldBorder}"
                              Foreground="{StaticResource BrushTextDark}"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static language:Resources.ScoreBoard_Position}"
                                                Binding="{Binding Position}" Width="84"
                                                ElementStyle="{StaticResource CenteredCellStyle}" />

                            <DataGridTemplateColumn Header="{x:Static language:Resources.ScoreBoard_PlayerProfile}"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Ellipse Width="44" Height="44"
                                                     Fill="{StaticResource BrushTextDark}"
                                                     Stroke="{StaticResource BrushTextLight}"
                                                     StrokeThickness="6" />
                                            <TextBlock Text="{Binding Username}" VerticalAlignment="Center"
                                                       Margin="8,0"
                                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                       Foreground="{StaticResource BrushTextDark}"
                                                       FontSize="{x:Static styles:FontTypography.FormLabelFontSize}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{x:Static language:Resources.ScoreBoard_Experience}"
                                                Binding="{Binding TotalXP}" Width="180"
                                                ElementStyle="{StaticResource CenteredCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
