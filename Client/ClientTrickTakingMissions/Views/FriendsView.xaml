<UserControl x:Class="View.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:language="clr-namespace:View.Properties.Langs"
             xmlns:styles="clr-namespace:View.Styles"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="260">

    <Border BorderBrush="Black"
            BorderThickness="3,0,0,0"
            Background="{x:Static styles:ColorPalette.SidebarBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado de Amigos -->
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,3">
                <Button x:Name="FriendsButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="FriendsButton_Click"
                        ToolTip="{x:Static language:Resources.GameMenu_Friends}">
                    <Canvas Width="70" Height="50">
                        <Ellipse Canvas.Left="16" Canvas.Top="0" Width="22" Height="22"
                                 Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                        <Path Data="M 6 48 C 6 36 14 30 27 30 C 40 30 48 36 48 48"
                              Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                        <Ellipse Canvas.Left="38" Canvas.Top="6" Width="18" Height="18"
                                 Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                        <Path Data="M 44 32 C 48 31 52 32 56 36 C 60 40 60 46 60 48"
                              Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                    </Canvas>
                </Button>
            </Border>

            <!-- Botones de Acción (Mensajes / Solicitudes y Añadir Amigo) -->
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MessagesButton"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MessagesButton_Click"
                            ToolTip="{x:Static language:Resources.GameMenu_Messages}">
                        <Canvas Width="48" Height="36">
                            <Rectangle Width="46" Height="32" Canvas.Left="1" Canvas.Top="2"
                                       Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Path Data="M 2 3 L 24 20 L 46 3"
                                  Stroke="Black"
                                  StrokeThickness="3.5"
                                  Fill="Transparent" />
                        </Canvas>
                    </Button>

                    <Button x:Name="AddFriendButton"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="AddFriendButton_Click"
                            ToolTip="{x:Static language:Resources.GameMenu_AddFriend}">
                        <Canvas Width="48" Height="36">
                            <Ellipse Canvas.Left="12" Canvas.Top="0" Width="16" Height="16"
                                     Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Path Data="M 2 34 C 2 24 9 20 20 20 C 31 20 38 24 38 34"
                                  Stroke="Black" StrokeThickness="3.5" Fill="Transparent" />
                            <Line X1="41" Y1="14" X2="41" Y2="24"
                                  Stroke="Black" StrokeThickness="3.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="36" Y1="19" X2="46" Y2="19"
                                  Stroke="Black" StrokeThickness="3.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>
            </Border>

            <!-- Lista de Amigos -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FriendsListStackPanel" Margin="10">
                        <Border Background="{x:Static styles:ColorPalette.FriendCardBackgroundBrush}"
                                CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="User 1"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14" />
                                <TextBlock x:Name="OnlineStatusTextBlock"
                                           Text="{x:Static language:Resources.FriendsBar_Online}"
                                           Foreground="{x:Static styles:ColorPalette.OnlineStatusTextBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,4" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="ViewProfileButton"
                                            Content="{x:Static language:Resources.FriendsBar_ViewProfile}"
                                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                                            Foreground="Black"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            Click="ViewProfileButton_Click" />
                                    <Button x:Name="DeleteFriendButton"
                                            Content="{x:Static language:Resources.FriendsBar_DeleteFriend}"
                                            Background="{x:Static styles:ColorPalette.DeleteButtonBackgroundBrush}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            Click="DeleteFriendButton_Click" />
                                    <Button x:Name="InviteFriendButton"
                                            Content="{x:Static language:Resources.FriendsBar_GameInvitation}"
                                            Background="{x:Static styles:ColorPalette.InviteButtonBackgroundBrush}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            Click="InviteFriendButton_Click"
                                            Visibility="{Binding InviteButtonVisibility,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
