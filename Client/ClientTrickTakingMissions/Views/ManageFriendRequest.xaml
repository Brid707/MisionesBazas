<Window x:Class="View.Views.ManageFriendRequest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="ManageFriendRequest"
        Height="550" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}" BorderThickness="3">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{x:Static styles:ColorPalette.DialogBackgroundGradientStartColor}"
                                  Offset="0.0" />
                    <GradientStop Color="{x:Static styles:ColorPalette.DialogBackgroundGradientStep1Color}"
                                  Offset="0.25" />
                    <GradientStop Color="{x:Static styles:ColorPalette.DialogBackgroundGradientStep2Color}"
                                  Offset="0.6" />
                    <GradientStop Color="{x:Static styles:ColorPalette.DialogBackgroundGradientEndColor}"
                                  Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                    BorderThickness="0,0,0,3"
                    Background="{x:Static styles:ColorPalette.DialogHeaderBackgroundBrush}">
                <Grid Margin="12,10,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Static language:Resources.ManageFriendRequest_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               LineHeight="34" />

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Width="38" Height="38"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                        <Grid Width="36" Height="36">
                            <Ellipse Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                                     StrokeThickness="3.5" Fill="Transparent" />
                            <TextBlock Text="✕"
                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                       FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RequestsContainer">
                    <Border x:Name="SampleRequestRow"
                            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                            BorderThickness="0,0,0,3"
                            Background="{x:Static styles:ColorPalette.RequestCardBackgroundBrush}"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="48" Height="48">
                                <Ellipse Fill="{x:Static styles:ColorPalette.PureBlackBrush}" />
                                <Ellipse Width="16" Height="16"
                                         Fill="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                         Margin="0,7,0,0" VerticalAlignment="Top" />
                                <Path Data="M 8 40 C 8 29 14 25 24 25 C 34 25 40 29 40 40"
                                      Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
                            </Grid>

                            <TextBlock x:Name="LblSampleUsername"
                                       Grid.Column="1"
                                       Text="xX_Denis_Xx"
                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                       FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0"
                                       TextTrimming="CharacterEllipsis" />

                            <Button x:Name="AcceptButton"
                                    Grid.Column="2"
                                    Width="38" Height="38"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{x:Static language:Resources.ManageFriendRequest_Tooltip_Accept}"
                                    Command="{Binding AcceptRequestCommand}">
                                <Grid Width="36" Height="36">
                                    <Ellipse Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                                             StrokeThickness="3.5" Fill="Transparent" />
                                    <Path Data="M 9 18 L 15 24 L 27 11"
                                          Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                                          StrokeThickness="3.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top" />
                                </Grid>
                            </Button>

                            <Button x:Name="RejectButton"
                                    Grid.Column="3"
                                    Width="38" Height="38"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{x:Static language:Resources.ManageFriendRequest_Tooltip_Reject}"
                                    Command="{Binding RejectRequestCommand}">
                                <Grid Width="36" Height="36">
                                    <Ellipse Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                                             StrokeThickness="3.5" Fill="Transparent" />
                                    <Path Data="M 11 11 L 25 25 M 25 11 L 11 25"
                                          Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                                          StrokeThickness="3.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Message when there are no requests -->
                    <TextBlock x:Name="TxtNoRequests"
                               Text="{x:Static language:Resources.ManageFriendRequest_Label_NoPendingRequests}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{x:Static styles:ColorPalette.EmptyStateTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
