<Page x:Class="View.Views.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="Profile">

    <Grid Background="{x:Static styles:ColorPalette.TableAlternateRowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Source="ProfileCards.png"
               Stretch="Fill"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Width="150" />

        <Grid Grid.Column="1" Margin="30,24,40,30">
            <Button x:Name="BtnClose"
                    Width="50" Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Grid Width="44" Height="44">
                    <Ellipse Fill="{x:Static styles:ColorPalette.PureBlackBrush}" Width="44" Height="44" />
                    <Path Stroke="{x:Static styles:ColorPalette.TableAlternateRowBackgroundBrush}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 14 14 L 30 30 M 30 14 L 14 30" />
                </Grid>
            </Button>

            <StackPanel Margin="30,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,32">
                    <Grid Width="96" Height="96">
                        <Ellipse Fill="{x:Static styles:ColorPalette.PureBlackBrush}"
                                 Width="96" Height="96" />
                        <Ellipse Fill="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                 Width="30" Height="30" Margin="0,18,0,0" VerticalAlignment="Top" />
                        <Path Fill="{x:Static styles:ColorPalette.PureWhiteBrush}"
                              Data="M 20 78 C 20 58 34 52 48 52 C 62 52 76 58 76 78 Z" />
                    </Grid>

                    <TextBlock x:Name="lblNombreUsuario"
                               Text="xX_Samuel_Xx"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.ProfileTitleFontSize}"
                               FontWeight="Normal"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               VerticalAlignment="Center"
                               Margin="28,0,0,0" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,80,0">
                        <Label x:Name="lblCreacionCuenta"
                               Content="{x:Static language:Resources.Profile_AccountCreation}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                               FontWeight="Normal"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Padding="0"
                               VerticalAlignment="Center" />
                        <Label x:Name="lblFecha"
                               Content="{x:Static language:Resources.Profile_Date}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                               FontWeight="Normal"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Padding="0"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lblMisiones"
                               Content="{x:Static language:Resources.Profile_Missions}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                               FontWeight="Normal"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Padding="0"
                               VerticalAlignment="Center" />
                        <Label x:Name="lblMisionesValor"
                               Content="0"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                               FontWeight="Normal"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Padding="0"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <Label x:Name="lblBiografia"
                       Content="{x:Static language:Resources.Profile_Biography}"
                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                       FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                       FontWeight="Normal"
                       Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                       Padding="0"
                       Margin="0,0,0,10" />

                <TextBox x:Name="txtBiografia"
                         Width="660"
                         Height="160"
                         Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                         Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                         FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                         FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                         Padding="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,24" />

                <StackPanel Orientation="Horizontal">
                    <Label x:Name="lblCorreo"
                           Content="{x:Static language:Resources.Profile_Email}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                           FontWeight="Normal"
                           Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                           Padding="0"
                           VerticalAlignment="Center" />
                    <Label x:Name="lblCorreoValor"
                           Content="correo@correo.com"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.SubtitleFontSize}"
                           FontWeight="Normal"
                           Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                           Padding="0"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
