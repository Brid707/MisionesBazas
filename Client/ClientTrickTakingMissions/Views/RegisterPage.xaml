<Page x:Class="View.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="{x:Static language:Resources.Register_Title}">

    <Grid Background="{StaticResource BrushTextDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*" />
            <ColumnDefinition Width="0.55*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientStart}"
                                  Offset="0" />
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientStep}"
                                  Offset="0.5" />
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientEnd}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <Viewbox MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock x:Name="RegisterTitleTextBlock" Text="{x:Static language:Resources.Register_Title}"
                                   Foreground="{StaticResource BrushGoldAccent}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="{x:Static styles:FontTypography.DisplayTitleFontSize}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left" />
                    </Viewbox>

                    <TextBlock x:Name="RestrictionsTextBlock" Text="{x:Static language:Resources.Register_Restrictions}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushGoldAccent}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                               Margin="0,24,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BrushTextDark}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button x:Name="BackButton" Content="{x:Static language:Resources.Common_Button_Back}"
                        Width="48" Height="48" Margin="-565,43,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                        Command="{Binding BackCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="{x:Static language:Resources.Register_Email}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="EmailTextBox" Height="50"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                         FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                         Padding="8" Margin="0,0,0,12" />

                <TextBlock Text="{x:Static language:Resources.Register_Username}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="UsernameTextBox" Height="50"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                         FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                         Padding="8" Margin="0,0,0,12" />

                <TextBlock Text="{x:Static language:Resources.Register_Password}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Height="50"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                             Padding="8" Margin="0,0,0,12"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <TextBlock Text="{x:Static language:Resources.Register_ConfirmPassword}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmPasswordBox" Height="50"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                             Padding="8" Margin="0,0,0,18"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                <Button x:Name="SubmitButton"
                        Content="{x:Static language:Resources.Register_SubmitButton}"
                        Height="64" Width="220"
                        Background="{StaticResource BrushSubmitButtonBackground}"
                        Foreground="{StaticResource BrushTextDark}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.PrimaryActionFontSize}"
                        FontWeight="Bold"
                        Command="{Binding SubmitCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
