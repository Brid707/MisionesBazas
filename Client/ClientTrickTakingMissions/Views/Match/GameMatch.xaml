<Page x:Class="View.Views.GameMatch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:View.Converters"
      xmlns:controls="clr-namespace:View.Controls"
      xmlns:styles="clr-namespace:View.Styles"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:constants="clr-namespace:ViewModel.Constants;assembly=ViewModel"
      xmlns:gameplay="clr-namespace:Gameplay;assembly=Model"
      Title="GameMatch">
    <Page.Resources>
        <converters:MatchFeedbackKeyToStringConverter x:Key="MatchTextConverter" />
        <converters:MissionObjectiveCardIdToImagePathConverter x:Key="ObjectiveCardImageConverter" />
        <converters:MissionObjectiveTokenToImagePathConverter x:Key="ObjectiveTokenImageConverter" />
        <DataTemplate x:Key="MissionObjectiveArtworkTemplate">
            <Grid Width="132" Height="206" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <Grid.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding ObjectiveStatusResourceKey,
                            Converter={StaticResource MatchTextConverter}}" />
                        <TextBlock Text="{Binding CompletedAtTrickNumber}" />
                    </StackPanel>
                </Grid.ToolTip>
                <Border BorderThickness="2" CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushTransparent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Image Width="124" Height="174" Stretch="Uniform"
                       Source="{Binding CardId, Converter={StaticResource ObjectiveCardImageConverter}}" />
                <Image Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Source="{Binding Token, Converter={StaticResource ObjectiveTokenImageConverter}}" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource BrushTextLight}"
                           Text="{Binding ObjectiveStatusResourceKey, Converter={StaticResource MatchTextConverter}}" />
            </Grid>
        </DataTemplate>
        <converters:CardIdToImagePathConverter x:Key="CardImageConverter" />
        <converters:RadioTokenPositionToVerticalAlignmentConverter x:Key="RadioTokenPositionConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="CommunicatedCardTemplate">
            <Grid Width="72" Height="100" Margin="4">
                <Border BorderThickness="1.5" CornerRadius="3"
                        BorderBrush="{StaticResource BrushGoldAccent}">
                    <Image Stretch="Uniform"
                           Source="{Binding CommunicatedCardId,
                               Converter={StaticResource CardImageConverter}}" />
                </Border>
                <Image Width="42" Height="42" Stretch="Uniform" HorizontalAlignment="Center"
                       Source="/View;component/Assets/Images/Tokens/Indicators/Token_Interference.png"
                       VerticalAlignment="{Binding CommunicatedTokenPosition,
                           Converter={StaticResource RadioTokenPositionConverter}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlayerIdentityTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ScrollViewer MaxWidth="116" MaxHeight="164" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MissionObjectives}"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Viewbox Width="104" Height="158" Stretch="Uniform">
                                    <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource MissionObjectiveArtworkTemplate}" />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <ContentControl Content="{Binding ProfileImage}"
                                        Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        ContentTemplate="{StaticResource ProfileAvatarTemplate}" />
                        <Image x:Name="CaptainTokenImage" Width="42" Height="42"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Uniform"
                               Source="/View;component/Assets/Images/Tokens/Indicators/Token_Captain.png"
                               ToolTip="{Binding Source=Match_Captain, Converter={StaticResource MatchTextConverter}}"
                               Visibility="{Binding IsMissionCaptain,
                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding Username}" MaxWidth="120" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Username}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextLight}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.FormLabelFontSize}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,4,0" Foreground="{StaticResource BrushTextLight}"
                                   Text="{Binding Source=Match_WonTricksCount,
                                       Converter={StaticResource MatchTextConverter}}" />
                        <TextBlock Text="{Binding WonTrickCount}" Foreground="{StaticResource BrushTextLight}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WonCardsTemplate">
            <Grid Width="76" Height="104" VerticalAlignment="Center"
                  Visibility="{Binding HasWonTricks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Width="64" Height="88" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="Uniform" Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                <Image Width="64" Height="88" Margin="6,8,0,0" HorizontalAlignment="Left"
                       VerticalAlignment="Top" Stretch="Uniform"
                       Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                <Image Width="64" Height="88" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Stretch="Uniform" Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="VerticalHiddenHandTemplate">
            <ItemsControl ItemsSource="{Binding HiddenCardSlots}" Margin="0,102,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Width="84" Height="116" Margin="0,-102,0,0" Stretch="Uniform"
                               Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="HorizontalHiddenHandTemplate">
            <ItemsControl ItemsSource="{Binding HiddenCardSlots}" Margin="60,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Width="84" Height="116" Margin="-60,0,0,0" Stretch="Uniform"
                               Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="SidePlayerTemplate">
            <StackPanel Width="260" HorizontalAlignment="Center">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ContentControl Content="{Binding}" Margin="0,8,0,0"
                                    ContentTemplate="{StaticResource VerticalHiddenHandTemplate}" />
                <ContentControl Content="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"
                                ContentTemplate="{StaticResource WonCardsTemplate}" />
                <ContentControl Content="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"
                                ContentTemplate="{StaticResource CommunicatedCardTemplate}"
                                Visibility="{Binding HasCommunicatedCard,
                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PlayedCardTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="88" Height="122" Stretch="Uniform"
                       Source="{Binding CardId, Converter={StaticResource CardImageConverter}}" />
                <TextBlock Text="{Binding PlayerUsername}" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextLight}" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TrickTablePanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </ItemsPanelTemplate>
        <Style x:Key="PlayedCardPositionStyle" TargetType="ContentPresenter">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Left}">
                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Top}">
                    <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Right}">
                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource BrushLobbyMatchSurface}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource BrushLobbyMatchSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="550" />
                    <RowDefinition Height="280" />
                </Grid.RowDefinitions>
                <Grid Margin="36,16">
                    <TextBlock HorizontalAlignment="Left"
                               Foreground="{StaticResource BrushTextDark}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}">
                        <Run Text="{x:Static language:Resources.GameMatch_Mission}" />
                        <Run Text=" " /><Run Text="{Binding MatchBoard.MissionProgressDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextDark}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}">
                        <Run Text="{x:Static language:Resources.GameMatch_Trick}" />
                        <Run Text=" " /><Run Text="{Binding MatchBoard.TrickProgressDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,70,0">
                        <Button Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="{StaticResource BrushTransparent}" BorderThickness="0" Padding="0"
                                Command="{Binding MatchBoard.OpenDistressSignalDialogCommand}"
                                ToolTip="{Binding Source=Match_Button_DistressSignal,
                                    Converter={StaticResource MatchTextConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Button.Template>
                            <Image Width="44" Height="44" Stretch="Uniform"
                                   Source="/View;component/Assets/Images/Tokens/Indicators/Token_Distress.png">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MatchBoard.CanUseDistressSignal}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Button>

                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushTextLight}"
                            Margin="0,0,6,0"
                                   Text="{Binding Source=MissionRetry_Label_Attempt,
                                       Converter={StaticResource MatchTextConverter}}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding MatchBoard.CurrentMissionAttemptNumber}"
                                   Foreground="{StaticResource BrushTextLight}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding MatchBoard.IsHeartCaptureProgressVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextLight}" Margin="0,0,4,0"
                                Text="{Binding Source=MissionRole_Label_HeartProgress,
                                    Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Foreground="{StaticResource BrushTextLight}"
                                Text="{Binding MatchBoard.HeartCaptureProgressDisplay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Width="46" Height="42" HorizontalAlignment="Right" Content="?"
                            Background="{StaticResource BrushTransparent}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                            Command="{Binding HowToPlayCommand}"
                            ToolTip="{x:Static language:Resources.GameMenu_HowToPlay}" />
                </Grid>
                <Grid Grid.Row="1" Margin="36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" /><ColumnDefinition /><ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="LeftPlayerSeat" Grid.Column="0" Content="{Binding LeftPlayer}"
                                    VerticalAlignment="Center" ContentTemplate="{StaticResource SidePlayerTemplate}" />
                    <ContentControl x:Name="RightPlayerSeat" Grid.Column="2" Content="{Binding RightPlayer}"
                                    VerticalAlignment="Center" ContentTemplate="{StaticResource SidePlayerTemplate}" />
                    <StackPanel x:Name="TopPlayerSeat" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="{Binding HasTopPlayer,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl Content="{Binding TopPlayer}"
                                        ContentTemplate="{StaticResource HorizontalHiddenHandTemplate}" />
                        <ContentControl Content="{Binding TopPlayer}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                        <ContentControl Content="{Binding TopPlayer}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource WonCardsTemplate}" />
                        <ContentControl Content="{Binding TopPlayer}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource CommunicatedCardTemplate}"
                                        Visibility="{Binding TopPlayer.HasCommunicatedCard,
                                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="500" Height="380" VerticalAlignment="Bottom" Margin="0,0,0,4"
                          DataContext="{Binding MatchBoard}">
                        <Border Panel.ZIndex="1" Background="{StaticResource BrushBurgundySurface}" Padding="12"
                                Visibility="{Binding IsObjectiveDraftVisible,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           Text="{Binding Source=MissionDraft_Title_Preparation,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Grid.Row="1" Foreground="{StaticResource BrushTextLight}"
                                    TextAlignment="Center"
                                           Text="{Binding CurrentObjectiveDraftPlayerName}" />
                                <ScrollViewer Grid.Row="2" Margin="0,10" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding UnassignedMissionObjectives}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid>
                                                    <UniformGrid.Style>
                                                        <Style TargetType="UniformGrid">
                                                            <Setter Property="Columns" Value="3" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Items.Count,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}" Value="1">
                                                                    <Setter Property="Columns" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Items.Count,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}" Value="2">
                                                                    <Setter Property="Columns" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UniformGrid.Style>
                                                </UniformGrid>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{StaticResource BrushTransparent}" Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                        Command="{Binding DataContext.SelectMissionObjectiveCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding MissionObjectiveId}"
                                                        ToolTip="{Binding Source=MissionDraft_Button_Select,
                                                            Converter={StaticResource MatchTextConverter}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.65" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource
                                                            MissionObjectiveArtworkTemplate}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Row="3" Command="{Binding PassObjectiveDraftCommand}" Margin="0,8,0,0"
                                        MinHeight="36"
                                        Background="{StaticResource BrushSubmitButtonBackground}">
                                    <TextBlock Text="{Binding Source=MissionDraft_Button_Pass,
                                        Converter={StaticResource MatchTextConverter}}" />
                                </Button>
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="CurrentTrickTable" ItemsSource="{Binding CurrentTrickCardPlays}"
                                      ItemsPanel="{StaticResource TrickTablePanel}"
                                      ItemTemplate="{StaticResource PlayedCardTemplate}"
                                      ItemContainerStyle="{StaticResource PlayedCardPositionStyle}" />
                        <ItemsControl x:Name="CompletedTrickTable" ItemsSource="{Binding LastCompletedTrickCardPlays}"
                                      ItemsPanel="{StaticResource TrickTablePanel}"
                                      ItemTemplate="{StaticResource PlayedCardTemplate}"
                                      ItemContainerStyle="{StaticResource PlayedCardPositionStyle}"
                                      Visibility="{Binding ShouldShowLastCompletedTrick,
                                          Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="50"
                            DataContext="{Binding MatchBoard}"
                            Background="{StaticResource BrushBurgundySurface}" Padding="18"
                            CornerRadius="10" BorderBrush="{StaticResource BrushGoldAccent}" BorderThickness="2"
                            Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsDistressSignalDialogOpen,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Phase 1: Confirm initiate vote (Initiator only) -->
                            <StackPanel Visibility="{Binding IsDistressInitiatorConfirmVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                           Text="{Binding Source=Match_Distress_Title,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,16" FontSize="12"
                                           Text="{Binding Source=Match_Distress_ConfirmInitiate,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding ProposeDistressSignalUsageCommand}" Margin="6,0"
                                            Padding="12,6" Background="{StaticResource BrushSuccessButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Button_Initiate,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" FontWeight="Bold" />
                                    </Button>
                                    <Button Command="{Binding CloseDistressSignalDialogCommand}" Margin="6,0"
                                            Padding="12,6"
                                            Background="{StaticResource BrushSecondaryButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Vote_Reject,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Phase 2: Usage Vote (All players vote Yes / No) -->
                            <StackPanel Visibility="{Binding IsDistressUsageVoteVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                           Text="{Binding Source=Match_Distress_Title,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,6,0,4">
                                    <TextBlock Text="{Binding DistressInitiatorName}" FontWeight="Bold"
                                               Foreground="{StaticResource BrushGoldAccent}" FontSize="12" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding Source=Match_Distress_Proposed_By,
                                        Converter={StaticResource MatchTextConverter}}"
                                               Foreground="{StaticResource BrushTextLight}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,6,0,14" FontSize="12"
                                           Text="{Binding Source=Match_Distress_UsageQuestion,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding VoteDistressUsageYesCommand}" Margin="6,0"
                                            Padding="14,6" Background="{StaticResource BrushSuccessButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Vote_Accept,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" FontWeight="Bold" />
                                    </Button>
                                    <Button Command="{Binding VoteDistressUsageNoCommand}" Margin="6,0"
                                            Padding="14,6"
                                            Background="{StaticResource BrushSecondaryButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Vote_Reject,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Phase 3: Direction Vote (All players vote Left vs Right) -->
                            <StackPanel Visibility="{Binding IsDistressDirectionVoteVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                           Text="{Binding Source=Match_Distress_Title,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,8,0,12" FontSize="12"
                                           Text="{Binding Source=Match_Distress_DirectionQuestion,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding VoteDistressDirectionLeftCommand}" Margin="8,0"
                                            Padding="12,6" Background="{StaticResource BrushSubmitButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Direction_Left,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" FontWeight="Bold" />
                                    </Button>
                                    <Button Command="{Binding VoteDistressDirectionRightCommand}" Margin="8,0"
                                            Padding="12,6" Background="{StaticResource BrushSubmitButtonBackground}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Direction_Right,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Phase 4: Card Selection (Each player picks 1 card) -->
                            <StackPanel Visibility="{Binding IsDistressCardSelectionVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                           Text="{Binding Source=Match_Distress_Title,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontWeight="Bold" Margin="0,4,0,2" FontSize="12"
                                           Text="{Binding DistressAgreedDirectionResourceKey,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,2,0,6" FontSize="11"
                                           Text="{Binding Source=Match_Distress_CardSelectPrompt,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <ItemsControl ItemsSource="{Binding EligibleDistressCardIds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="{StaticResource BrushTransparent}"
                                                    Padding="0" Margin="2"
                                                    Command="{Binding DataContext.SelectDistressCardCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Width="36" Height="50" Stretch="Uniform"
                                                       Source="{Binding Converter={StaticResource
                                                           CardImageConverter}}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                            Visibility="{Binding CanConfirmDistressCard,
                                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Source=Match_Distress_SelectedCard,
                                        Converter={StaticResource MatchTextConverter}}"
                                               Foreground="{StaticResource BrushTextLight}"
                                               VerticalAlignment="Center" FontSize="11" />
                                    <Image Width="28" Height="38" Stretch="Uniform" Margin="6,0,0,0"
                                           Source="{Binding SelectedDistressCardId,
                                               Converter={StaticResource CardImageConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Command="{Binding ConfirmDistressCardSelectionCommand}" Margin="4,0"
                                            Padding="14,6" Background="{StaticResource BrushSuccessButtonBackground}"
                                            IsEnabled="{Binding CanConfirmDistressCard}">
                                        <TextBlock Text="{Binding Source=Match_Distress_Button_ConfirmPass,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Phase 5: Waiting for crew members -->
                            <StackPanel Visibility="{Binding IsDistressWaitingVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource BrushGoldAccent}" TextAlignment="Center"
                                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                           Text="{Binding Source=Match_Distress_Title,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,6" FontSize="12"
                                           Text="{Binding DistressStepWaitingResourceKey,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                                    <TextBlock Text="{Binding Source=Match_Distress_Waiting_Progress,
                                        Converter={StaticResource MatchTextConverter}}"
                                               Foreground="{StaticResource BrushTextLight}" FontSize="12" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding DistressWaitingProgressText}"
                                               Foreground="{StaticResource BrushGoldAccent}"
                                               FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                                <Button Command="{Binding CancelDistressProposalCommand}" Margin="0,4,0,0"
                                        Padding="12,6" HorizontalAlignment="Center"
                                        Background="{StaticResource BrushSecondaryButtonBackground}">
                                    <TextBlock Text="{Binding Source=Match_Distress_Cancel_Proposal,
                                        Converter={StaticResource MatchTextConverter}}"
                                               Foreground="{StaticResource BrushTextLight}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="36,0,36,8" DataContext="{Binding MatchBoard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <ToggleButton x:Name="SpecialPreparationToggleButton" Margin="0,0,0,5"
                            IsChecked="{Binding IsSpecialPreparationPanelOpen, Mode=TwoWay}"
                            Visibility="{Binding IsSpecialPreparationVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="{Binding SpecialPreparationFeedbackKey,
                                Converter={StaticResource MatchTextConverter}}" />
                        <Popup PlacementTarget="{Binding ElementName=SpecialPreparationToggleButton}" Placement="Top"
                            IsOpen="{Binding IsSpecialPreparationPanelOpen, Mode=TwoWay}"
                            StaysOpen="False" AllowsTransparency="True">
                            <Border Padding="12" Width="460" Background="{StaticResource BrushLobbyMatchSurface}"
                                BorderThickness="2" BorderBrush="{StaticResource BrushTextDark}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextLight}"
                                        Text="{Binding SpecialPreparationFeedbackKey,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <ComboBox Margin="0,8" ItemsSource="{Binding EligibleRoleParticipants}"
                                        Visibility="{Binding IsRoleAssignmentVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        DisplayMemberPath="Username" SelectedItem="{Binding SelectedRoleParticipant}"
                                        IsEnabled="{Binding CanSelectRoleParticipant}" />
                                    <Button Command="{Binding AssignMissionRoleCommand}"
                                        Visibility="{Binding IsRoleAssignmentVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="{Binding Source=MissionPreparation_Label_Assign,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"
                                        Visibility="{Binding IsBlindResponseChoiceVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding RespondCapableCommand}" Margin="4,0"
                                            Content="{Binding Source=MissionPreparation_Response_Yes,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <Button Command="{Binding RespondNotCapableCommand}" Margin="4,0"
                                            Content="{Binding Source=MissionPreparation_Response_No,
                                                Converter={StaticResource MatchTextConverter}}" />
                                    </StackPanel>
                                    <Button Command="{Binding IdentifyHeartNineOwnerCommand}"
                                        Visibility="{Binding IsHeartNineIdentificationStage,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="{Binding Source=MissionPreparation_Button_IdentifyHeartNine,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <StackPanel Visibility="{Binding IsTrickDistributionSelection,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Foreground="{StaticResource BrushTextLight}"
                                            Text="{Binding Source=MissionRole_Label_FirstFour,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <ComboBox ItemsSource="{Binding EligibleRoleParticipants}" DisplayMemberPath="Username"
                                            SelectedItem="{Binding SelectedFirstFourTrickWinner}" Margin="0,5" />
                                        <TextBlock Foreground="{StaticResource BrushTextLight}"
                                            Text="{Binding Source=MissionRole_Label_Last,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <ComboBox ItemsSource="{Binding EligibleRoleParticipants}" DisplayMemberPath="Username"
                                            SelectedItem="{Binding SelectedLastTrickWinner}" Margin="0,5" />
                                        <Button Command="{Binding AssignTrickDistributionCommand}"
                                            Content="{Binding Source=MissionPreparation_Button_AssignDistribution,
                                                Converter={StaticResource MatchTextConverter}}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding BlindObjectiveResponseDescriptions}"
                                        Visibility="{Binding AreBlindResponsesVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ParticipantName}" Margin="0,0,8,0"
                                                        Foreground="{StaticResource BrushTextLight}" />
                                                    <TextBlock Text="{Binding ResponseResourceKey,
                                                        Converter={StaticResource MatchTextConverter}}"
                                                        Foreground="{StaticResource BrushTextLight}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding HasSingleTrickWinner,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushTextLight}"
                                Margin="0,0,6,0"
                                Text="{Binding Source=MissionPreparation_Label_SingleTrickWinner,
                                    Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Foreground="{StaticResource BrushTextLight}"
                                Text="{Binding SingleTrickWinnerParticipantName}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ConfirmedMissionRoles}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource
                                            BrushTextLight}" Margin="0,0,6,0"
                                            Text="{Binding LabelResourceKey, Converter={StaticResource MatchTextConverter}}" />
                                        <TextBlock Foreground="{StaticResource BrushTextLight}" Text="{Binding ParticipantName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MissionInstructionResourceKey,
                                       Converter={StaticResource MatchTextConverter}}"
                                   Foreground="{StaticResource BrushTextLight}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding IsMissionInstructionVisible,
                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding MatchFeedbackResourceKey, Converter={StaticResource MatchTextConverter}}"
                                   Foreground="{StaticResource BrushTextLight}" TextWrapping="Wrap"
                                   TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsTrickTurnVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,6,0" Foreground="{StaticResource BrushTextLight}"
                                       Text="{Binding Source=Match_TurnPlayer,
                                           Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Text="{Binding CurrentTurnPlayerName}"
                                       Foreground="{StaticResource BrushTextLight}" />
                        </StackPanel>
                        <StackPanel x:Name="LastTrickWinnerPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasLastTrickWinner,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,6,0" Foreground="{StaticResource BrushTextLight}"
                                       Text="{Binding Source=Match_TrickWinner,
                                           Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Text="{Binding LastTrickWinnerName}"
                                       Foreground="{StaticResource BrushTextLight}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding IsMissionTransitionVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                       Text="{Binding MissionTransitionStatusResourceKey,
                                           Converter={StaticResource MatchTextConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="{Binding HasMissionTransitionCountdown,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding MissionTransitionRemainingSeconds}" Margin="0,0,4,0"
                                           Foreground="{StaticResource BrushTextLight}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}"
                                           Text="{Binding Source=MissionRetry_Label_Seconds,
                                               Converter={StaticResource MatchTextConverter}}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding RetryPendingMatchRequestCommand}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source=Match_Retry,
                                Converter={StaticResource MatchTextConverter}}" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="248" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="248" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="LocalPlayerWonCards" Grid.Column="0" HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Content="{Binding DataContext.BottomPlayer,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                        ContentTemplate="{StaticResource WonCardsTemplate}" />
                        <ContentControl Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Content="{Binding DataContext.BottomPlayer,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                        ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                        <ItemsControl x:Name="LocalPlayerHandItemsControl" Grid.Column="1"
                                      ItemsSource="{Binding OwnHandCards}"
                                      VerticalAlignment="Bottom" Margin="0,24,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:OverlappingCardHandPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding PlayCardCommand}" CommandParameter="{Binding CardId}"
                                            Padding="0"
                                            Background="{StaticResource BrushTransparent}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid Width="128" Height="178">
                                            <Image Stretch="Uniform" VerticalAlignment="Bottom"
                                                   Source="{Binding CardId,
                                                       Converter={StaticResource CardImageConverter}}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Width" Value="128" />
                                                        <Setter Property="Height" Value="178" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRaisedForCurrentTurn}"
                                                                         Value="False">
                                                                <Setter Property="Width" Value="94" />
                                                                <Setter Property="Height" Value="132" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <!-- Communication Token Indicator -->
                                            <Image Width="30" Height="30" Stretch="Uniform"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="{Binding TokenPosition,
                                                    Converter={StaticResource RadioTokenPositionConverter}}"
                                                Visibility="{Binding IsCommunicated,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Source=
"/View;component/Assets/Images/Tokens/Indicators/Token_Interference.png" />
                                        </Grid>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlightedForCommunication}"
                                                                 Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="-20" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource
                                                                    ColorGoldAccent}"
                                                                                  BlurRadius="20"
                                                                                  ShadowDepth="0" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDimmedForCommunication}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Communication Token Toggle Button -->
                        <Button Grid.Column="0" Width="58" Height="58" HorizontalAlignment="Right"
                                Margin="7,0,7,10" VerticalAlignment="Bottom"
                                Command="{Binding ToggleCommunicationModeCommand}"
                                ToolTip="{Binding Source=Match_Tooltip_CommunicationToken,
                                    Converter={StaticResource MatchTextConverter}}"
                                Background="{StaticResource BrushTransparent}" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Image x:Name="TokenImage" Width="54" Height="54" Stretch="Uniform"
                                        Source=
                                        "/View;component/Assets/Images/Tokens/Indicators/Token_Interference.png" />
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanCommunicate}" Value="False">
                                            <Setter TargetName="TokenImage" Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCommunicationModeActive}" Value="True">
                                            <Setter TargetName="TokenImage" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="{StaticResource ColorGoldAccent}"
                                                        BlurRadius="22"
                                                                      ShadowDepth="0" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
