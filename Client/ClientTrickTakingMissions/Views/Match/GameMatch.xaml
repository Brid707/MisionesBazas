<Page x:Class="View.Views.GameMatch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:View.Converters"
      xmlns:styles="clr-namespace:View.Styles"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:constants="clr-namespace:ViewModel.Constants;assembly=ViewModel"
      xmlns:gameplay="clr-namespace:Gameplay;assembly=Model"
      Title="GameMatch">
    <Page.Resources>
        <converters:MatchFeedbackKeyToStringConverter x:Key="MatchTextConverter" />
        <converters:MissionObjectiveCardIdToImagePathConverter x:Key="ObjectiveCardImageConverter" />
        <converters:MissionObjectiveTokenToImagePathConverter x:Key="ObjectiveTokenImageConverter" />
        <DataTemplate x:Key="MissionObjectiveArtworkTemplate">
            <Grid Width="64" Height="100" Margin="4">
                <Grid.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding ObjectiveStatusResourceKey,
                            Converter={StaticResource MatchTextConverter}}" />
                        <TextBlock Text="{Binding CompletedAtTrickNumber}" />
                    </StackPanel>
                </Grid.ToolTip>
                <Border BorderThickness="2" CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushTransparent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Image Width="58" Height="82" Stretch="Uniform"
                       Source="{Binding CardId, Converter={StaticResource ObjectiveCardImageConverter}}" />
                <Image Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Source="{Binding Token, Converter={StaticResource ObjectiveTokenImageConverter}}" />
                <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource BrushTextLight}"
                           Text="{Binding ObjectiveStatusResourceKey, Converter={StaticResource MatchTextConverter}}" />
            </Grid>
        </DataTemplate>
        <converters:CardIdToImagePathConverter x:Key="CardImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="PlayerIdentityTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ScrollViewer MaxWidth="184" MaxHeight="124" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MissionObjectives}"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Viewbox>
                                    <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource MissionObjectiveArtworkTemplate}" />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                <StackPanel HorizontalAlignment="Center">
                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                    <ContentControl Content="{Binding ProfileImage}"
                                    ContentTemplate="{StaticResource ProfileAvatarTemplate}" />
                    <Image x:Name="CaptainToken" Width="24" Height="24" Margin="0,-8,-14,0"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Uniform"
                           Source="/View;component/Assets/Images/Tokens/Indicators/Token_Captain.png"
                           ToolTip="{Binding Source=Match_Captain, Converter={StaticResource MatchTextConverter}}"
                           Visibility="{Binding IsMissionCaptain, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock Text="{Binding Username}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{StaticResource BrushTextLight}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Margin="0,0,4,0" Foreground="{StaticResource BrushTextLight}"
                               Text="{Binding Source=Match_WonTricksCount, Converter={StaticResource MatchTextConverter}}" />
                    <TextBlock Text="{Binding WonTrickCount}" Foreground="{StaticResource BrushTextLight}" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WonCardsTemplate">
            <ItemsControl ItemsSource="{Binding WonCardIds}" Margin="24,30,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasWonTricks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" Width="130" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Width="36" Height="50" Margin="-24,-30,0,0" Stretch="Uniform"
                               Source="{Binding Converter={StaticResource CardImageConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="VerticalHiddenHandTemplate">
            <ItemsControl ItemsSource="{Binding HiddenCardSlots}" Margin="0,76,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Width="72" Height="100" Margin="0,-76,0,0" Stretch="Uniform"
                               Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="HorizontalHiddenHandTemplate">
            <ItemsControl ItemsSource="{Binding HiddenCardSlots}" Margin="48,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Width="72" Height="100" Margin="-48,0,0,0" Stretch="Uniform"
                               Source="/View;component/Assets/Images/Cards/Card_Back_Default.png" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="SidePlayerTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                    <ContentControl Content="{Binding}" Margin="0,8,0,0"
                                    ContentTemplate="{StaticResource VerticalHiddenHandTemplate}" />
                </StackPanel>
                <ContentControl Content="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"
                                ContentTemplate="{StaticResource WonCardsTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PlayedCardTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="72" Height="100" Stretch="Uniform"
                       Source="{Binding CardId, Converter={StaticResource CardImageConverter}}" />
                <TextBlock Text="{Binding PlayerUsername}" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextLight}" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TrickTablePanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </ItemsPanelTemplate>
        <Style x:Key="PlayedCardPositionStyle" TargetType="ContentPresenter">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Left}">
                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Top}">
                    <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TablePosition}" Value="{x:Static constants:MatchTablePosition.Right}">
                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource BrushLobbyMatchSurface}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1365" Height="768" Background="{StaticResource BrushLobbyMatchSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="498" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>
                <Grid Margin="36,16">
                    <TextBlock HorizontalAlignment="Left"
                               Foreground="{StaticResource BrushTextDark}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}">
                        <Run Text="{x:Static language:Resources.GameMatch_Mission}" />
                        <Run Text=" " /><Run Text="{Binding MatchBoard.MissionProgressDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextDark}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}">
                        <Run Text="{x:Static language:Resources.GameMatch_Trick}" />
                        <Run Text=" " /><Run Text="{Binding MatchBoard.TrickProgressDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,70,0">
                        <TextBlock Foreground="{StaticResource BrushTextLight}" Margin="0,0,6,0"
                                   Text="{Binding Source=MissionRetry_Label_Attempt,
                                       Converter={StaticResource MatchTextConverter}}" />
                        <TextBlock Text="{Binding MatchBoard.CurrentMissionAttemptNumber}"
                                   Foreground="{StaticResource BrushTextLight}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding MatchBoard.IsHeartCaptureProgressVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextLight}" Margin="0,0,4,0"
                                Text="{Binding Source=MissionRole_Label_HeartProgress,
                                    Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Foreground="{StaticResource BrushTextLight}"
                                Text="{Binding MatchBoard.HeartCaptureProgressDisplay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Width="46" Height="42" HorizontalAlignment="Right" Content="?"
                            Background="{StaticResource BrushTransparent}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                            Command="{Binding HowToPlayCommand}"
                            ToolTip="{x:Static language:Resources.GameMenu_HowToPlay}" />
                </Grid>
                <Grid Grid.Row="1" Margin="36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" /><ColumnDefinition /><ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="LeftPlayerSeat" Grid.Column="0" Content="{Binding LeftPlayer}"
                                    VerticalAlignment="Center" ContentTemplate="{StaticResource SidePlayerTemplate}" />
                    <ContentControl x:Name="RightPlayerSeat" Grid.Column="2" Content="{Binding RightPlayer}"
                                    VerticalAlignment="Center" ContentTemplate="{StaticResource SidePlayerTemplate}" />
                    <StackPanel x:Name="TopPlayerSeat" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="{Binding HasTopPlayer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl Content="{Binding TopPlayer}"
                                        ContentTemplate="{StaticResource HorizontalHiddenHandTemplate}" />
                        <ContentControl Content="{Binding TopPlayer}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                        <ContentControl Content="{Binding TopPlayer}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource WonCardsTemplate}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="330" Height="340" VerticalAlignment="Bottom" Margin="0,0,0,4"
                          DataContext="{Binding MatchBoard}">
                        <Border Panel.ZIndex="1" Background="{StaticResource BrushBurgundySurface}" Padding="12"
                                Visibility="{Binding IsObjectiveDraftVisible,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           Text="{Binding Source=MissionDraft_Title_Preparation,
                                               Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                           Text="{Binding CurrentObjectiveDraftPlayerName}" />
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding UnassignedMissionObjectives}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="{StaticResource BrushTransparent}" Padding="0"
                                                    Command="{Binding DataContext.SelectMissionObjectiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding MissionObjectiveId}"
                                                    ToolTip="{Binding Source=MissionDraft_Button_Select,
                                                        Converter={StaticResource MatchTextConverter}}">
                                                <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource MissionObjectiveArtworkTemplate}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <Button Command="{Binding PassObjectiveDraftCommand}" Margin="0,8,0,0"
                                        Background="{StaticResource BrushSubmitButtonBackground}">
                                    <TextBlock Text="{Binding Source=MissionDraft_Button_Pass,
                                        Converter={StaticResource MatchTextConverter}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="CurrentTrickTable" ItemsSource="{Binding CurrentTrickCardPlays}"
                                      ItemsPanel="{StaticResource TrickTablePanel}"
                                      ItemTemplate="{StaticResource PlayedCardTemplate}"
                                      ItemContainerStyle="{StaticResource PlayedCardPositionStyle}" />
                        <ItemsControl x:Name="CompletedTrickTable" ItemsSource="{Binding LastCompletedTrickCardPlays}"
                                      ItemsPanel="{StaticResource TrickTablePanel}"
                                      ItemTemplate="{StaticResource PlayedCardTemplate}"
                                      ItemContainerStyle="{StaticResource PlayedCardPositionStyle}"
                                      Visibility="{Binding ShouldShowLastCompletedTrick, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
                <Grid Grid.Row="2" Margin="160,0,160,8" DataContext="{Binding MatchBoard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <ToggleButton x:Name="SpecialPreparationToggleButton" Margin="0,0,0,5"
                            IsChecked="{Binding IsSpecialPreparationPanelOpen, Mode=TwoWay}"
                            Visibility="{Binding IsSpecialPreparationVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="{Binding SpecialPreparationFeedbackKey,
                                Converter={StaticResource MatchTextConverter}}" />
                        <Popup PlacementTarget="{Binding ElementName=SpecialPreparationToggleButton}" Placement="Top"
                            IsOpen="{Binding IsSpecialPreparationPanelOpen, Mode=TwoWay}"
                            StaysOpen="False" AllowsTransparency="True">
                            <Border Padding="12" Width="460" Background="{StaticResource BrushLobbyMatchSurface}"
                                BorderThickness="2" BorderBrush="{StaticResource BrushTextDark}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextLight}"
                                        Text="{Binding SpecialPreparationFeedbackKey,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <ComboBox Margin="0,8" ItemsSource="{Binding EligibleRoleParticipants}"
                                        Visibility="{Binding IsRoleAssignmentVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        DisplayMemberPath="Username" SelectedItem="{Binding SelectedRoleParticipant}"
                                        IsEnabled="{Binding CanSelectRoleParticipant}" />
                                    <Button Command="{Binding AssignMissionRoleCommand}"
                                        Visibility="{Binding IsRoleAssignmentVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="{Binding Source=MissionPreparation_Label_Assign,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"
                                        Visibility="{Binding IsBlindResponseChoiceVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding RespondCapableCommand}" Margin="4,0"
                                            Content="{Binding Source=MissionPreparation_Response_Yes,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <Button Command="{Binding RespondNotCapableCommand}" Margin="4,0"
                                            Content="{Binding Source=MissionPreparation_Response_No,
                                                Converter={StaticResource MatchTextConverter}}" />
                                    </StackPanel>
                                    <Button Command="{Binding IdentifyHeartNineOwnerCommand}"
                                        Visibility="{Binding IsHeartNineIdentificationStage,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="{Binding Source=MissionPreparation_Button_IdentifyHeartNine,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    <StackPanel Visibility="{Binding IsTrickDistributionSelection,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Foreground="{StaticResource BrushTextLight}"
                                            Text="{Binding Source=MissionRole_Label_FirstFour,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <ComboBox ItemsSource="{Binding EligibleRoleParticipants}" DisplayMemberPath="Username"
                                            SelectedItem="{Binding SelectedFirstFourTrickWinner}" Margin="0,5" />
                                        <TextBlock Foreground="{StaticResource BrushTextLight}"
                                            Text="{Binding Source=MissionRole_Label_Last,
                                                Converter={StaticResource MatchTextConverter}}" />
                                        <ComboBox ItemsSource="{Binding EligibleRoleParticipants}" DisplayMemberPath="Username"
                                            SelectedItem="{Binding SelectedLastTrickWinner}" Margin="0,5" />
                                        <Button Command="{Binding AssignTrickDistributionCommand}"
                                            Content="{Binding Source=MissionPreparation_Button_AssignDistribution,
                                                Converter={StaticResource MatchTextConverter}}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding BlindObjectiveResponseDescriptions}"
                                        Visibility="{Binding AreBlindResponsesVisible,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ParticipantName}" Margin="0,0,8,0"
                                                        Foreground="{StaticResource BrushTextLight}" />
                                                    <TextBlock Text="{Binding ResponseResourceKey,
                                                        Converter={StaticResource MatchTextConverter}}"
                                                        Foreground="{StaticResource BrushTextLight}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="RadioPanelToggleButton" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source=Radio_Label_Communicate,
                                    Converter={StaticResource MatchTextConverter}}" />
                                <TextBlock Text="{Binding RadioCommunications.Count}" Margin="8,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=RadioPanelToggleButton}" Placement="Top"
                               IsOpen="{Binding IsChecked, ElementName=RadioPanelToggleButton, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Padding="12" MaxWidth="600" BorderThickness="2"
                                    Background="{StaticResource BrushLobbyMatchSurface}"
                                    BorderBrush="{StaticResource BrushTextDark}">
                                <StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource BrushTextLight}"
                                           Text="{Binding Source=Radio_Label_Help,
                                    Converter={StaticResource MatchTextConverter}}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ComboBox Width="110" Height="54" ItemsSource="{Binding OwnHandCards}"
                                              SelectedItem="{Binding SelectedRadioCard}"
                                              IsEnabled="{Binding CanChooseRadioCard}" Margin="4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image Height="44" Source="{Binding CardId,
                                                    Converter={StaticResource CardImageConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Width="180" ItemsSource="{Binding AvailableRadioMarkers}"
                                              SelectedItem="{Binding SelectedRadioMarker}"
                                              IsEnabled="{Binding CanChooseRadioCard}" Margin="4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResourceKey,
                                                    Converter={StaticResource MatchTextConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding SubmitRadioCommunicationCommand}" Margin="4" Padding="8">
                                        <TextBlock Text="{Binding Source=Radio_Label_Reveal,
                                            Converter={StaticResource MatchTextConverter}}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        <ItemsControl ItemsSource="{Binding RadioCommunications}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0,8,4">
                                        <TextBlock Text="{Binding ParticipantName}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextLight}" />
                                        <Grid Height="56" Width="44" HorizontalAlignment="Center">
                                            <Image Source="{Binding CardId,
                                                Converter={StaticResource CardImageConverter}}" />
                                            <Ellipse Width="10" Height="10" Margin="2"
                                                     Fill="{StaticResource BrushTextLight}"
                                                     Stroke="{StaticResource BrushTextDark}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Marker}"
                                                                Value="{x:Static gameplay:RadioCommunicationMarker.Highest}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Marker}"
                                                                Value="{x:Static gameplay:RadioCommunicationMarker.Only}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Marker}"
                                                                Value="{x:Static gameplay:RadioCommunicationMarker.Lowest}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding MarkerResourceKey,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}" />
                                        <TextBlock Text="{Binding Source=Radio_Label_Played,
                                            Converter={StaticResource MatchTextConverter}}"
                                                   Foreground="{StaticResource BrushTextLight}"
                                                   Visibility="{Binding HasCommunicatedCardBeenPlayed,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding HasSingleTrickWinner,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextLight}" Margin="0,0,6,0"
                                Text="{Binding Source=MissionPreparation_Label_SingleTrickWinner,
                                    Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Foreground="{StaticResource BrushTextLight}"
                                Text="{Binding SingleTrickWinnerParticipantName}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ConfirmedMissionRoles}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource BrushTextLight}" Margin="0,0,6,0"
                                            Text="{Binding LabelResourceKey, Converter={StaticResource MatchTextConverter}}" />
                                        <TextBlock Foreground="{StaticResource BrushTextLight}" Text="{Binding ParticipantName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MissionInstructionResourceKey,
                                       Converter={StaticResource MatchTextConverter}}"
                                   Foreground="{StaticResource BrushTextLight}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding IsMissionInstructionVisible,
                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding MatchFeedbackResourceKey, Converter={StaticResource MatchTextConverter}}"
                                   Foreground="{StaticResource BrushTextLight}" TextWrapping="Wrap"
                                   TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsTrickTurnVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,6,0" Foreground="{StaticResource BrushTextLight}"
                                       Text="{Binding Source=Match_TurnPlayer, Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Text="{Binding CurrentTurnPlayerName}" Foreground="{StaticResource BrushTextLight}" />
                        </StackPanel>
                        <StackPanel x:Name="LastTrickWinnerPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasLastTrickWinner, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,6,0" Foreground="{StaticResource BrushTextLight}"
                                       Text="{Binding Source=Match_TrickWinner, Converter={StaticResource MatchTextConverter}}" />
                            <TextBlock Text="{Binding LastTrickWinnerName}" Foreground="{StaticResource BrushTextLight}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding IsMissionTransitionVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextLight}" TextAlignment="Center"
                                       Text="{Binding MissionTransitionStatusResourceKey,
                                           Converter={StaticResource MatchTextConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="{Binding HasMissionTransitionCountdown,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding MissionTransitionRemainingSeconds}" Margin="0,0,4,0"
                                           Foreground="{StaticResource BrushTextLight}" />
                                <TextBlock Foreground="{StaticResource BrushTextLight}"
                                           Text="{Binding Source=MissionRetry_Label_Seconds,
                                               Converter={StaticResource MatchTextConverter}}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding RetryPendingMatchRequestCommand}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source=Match_Retry, Converter={StaticResource MatchTextConverter}}" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="LocalPlayerWonCards" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Content="{Binding DataContext.BottomPlayer, RelativeSource={RelativeSource AncestorType=Page}}"
                                        ContentTemplate="{StaticResource WonCardsTemplate}" />
                        <ContentControl HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Content="{Binding DataContext.BottomPlayer, RelativeSource={RelativeSource AncestorType=Page}}"
                                        ContentTemplate="{StaticResource PlayerIdentityTemplate}" />
                        <ItemsControl x:Name="LocalPlayerHand" ItemsSource="{Binding OwnHandCards}"
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="28,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding PlayCardCommand}" CommandParameter="{Binding CardId}"
                                            Margin="-28,0,0,0" Padding="0" Background="{StaticResource BrushTransparent}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid Width="72" Height="100">
                                            <Image Stretch="Uniform" VerticalAlignment="Bottom"
                                                   Source="{Binding CardId, Converter={StaticResource CardImageConverter}}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Width" Value="72" />
                                                        <Setter Property="Height" Value="100" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRaisedForCurrentTurn}" Value="False">
                                                                <Setter Property="Width" Value="50" />
                                                                <Setter Property="Height" Value="70" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
