<Window x:Class="View.Views.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="ChangePassword" Height="380" Width="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
            BorderThickness="3" CornerRadius="4" Background="Transparent" Padding="8">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{x:Static styles:ColorPalette.ModalAccentGradientStartColor}"
                                  Offset="0" />
                    <GradientStop Color="{x:Static styles:ColorPalette.ModalAccentGradientEndColor}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />

                    <Button x:Name="BtnCloseTop" Width="40" Height="40"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                            BorderThickness="2" Click="BtnCloseTop_Click">
                        <TextBlock Text="✕"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="16"
                            HorizontalAlignment="Center" Width="520">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Information}"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                               Margin="4" />

                    <TextBox x:Name="PasswordBox1" Height="64"
                             Background="{x:Static styles:ColorPalette.InputFieldBackgroundBrush}"
                             BorderBrush="{x:Static styles:ColorPalette.InputFieldBorderBrush}"
                             BorderThickness="2"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                             Padding="8" Margin="0,12,0,8"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                             Text="{x:Static language:Resources.ChangePassword_PasswordField}" />

                    <TextBox x:Name="PasswordBox2" Height="64"
                             Background="{x:Static styles:ColorPalette.InputFieldBackgroundBrush}"
                             BorderBrush="{x:Static styles:ColorPalette.InputFieldBorderBrush}"
                             BorderThickness="2"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                             Padding="8" Margin="0,8,0,16"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                             Text="{x:Static language:Resources.ChangePassword_ConfirmPasswordField}" />

                    <Button x:Name="ConfirmButton" Content="Confirmar" Width="180" Height="44"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            FontWeight="SemiBold" BorderThickness="0"
                            HorizontalAlignment="Center" Click="ConfirmButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
