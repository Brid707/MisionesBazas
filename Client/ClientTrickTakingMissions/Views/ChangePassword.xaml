<Window x:Class="View.Views.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        mc:Ignorable="d"
        Title="ChangePassword" Height="380" Width="640" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border BorderBrush="#000" BorderThickness="3" CornerRadius="4" Background="Transparent" Padding="8">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8B0000" Offset="0" />
                    <GradientStop Color="#d22020" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Title}" FontFamily="Impact" FontSize="32" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />

                    <Button x:Name="BtnCloseTop" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2a0000" BorderBrush="#000" BorderThickness="2" Click="BtnCloseTop_Click">
                        <TextBlock Text="✕" FontSize="18" Foreground="#000" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="16" HorizontalAlignment="Center" Width="520">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Information}" Foreground="#000" FontSize="16" Margin="4" />

                    <TextBox x:Name="PasswordBox1" Height="64" Background="#f04a4a" BorderBrush="#8b0000" BorderThickness="2" FontSize="18" Padding="8" Margin="0,12,0,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#000" Text="{x:Static language:Resources.ChangePassword_PasswordField}" />

                    <TextBox x:Name="PasswordBox2" Height="64" Background="#f04a4a" BorderBrush="#8b0000" BorderThickness="2" FontSize="18" Padding="8" Margin="0,8,0,16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#000" Text="{x:Static language:Resources.ChangePassword_ConfirmPasswordField}" />

                    <Button x:Name="ConfirmButton" Content="Confirmar" Width="180" Height="44" Background="#FFF36B" Foreground="#000" FontSize="18" FontWeight="SemiBold" BorderThickness="0" HorizontalAlignment="Center" Click="ConfirmButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
