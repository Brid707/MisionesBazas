<Page x:Class="View.Views.SendFriendRequest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:language="clr-namespace:View.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="420"
      Title="SendFriendRequest">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#4A0003" Offset="0.0" />
                <GradientStop Color="#700006" Offset="0.3" />
                <GradientStop Color="#8A0B0B" Offset="0.8" />
                <GradientStop Color="#910000" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="Black" BorderThickness="3" Margin="12" Background="#7a0000">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="Transparent" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Static language:Resources.SendFriendRequest_Title}"
                               FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontSize="28"
                               Foreground="#FFF36B"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Margin="0,8,0,8" />

                    <Button x:Name="BtnClose" Grid.Column="2" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderBrush="Black" BorderThickness="3" Cursor="Hand" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="8,16,8,8">
                    <TextBlock Text="{x:Static language:Resources.SendFriendRequest_Information}" FontSize="18" Foreground="#000" Margin="6,6,6,12" />

                    <TextBox x:Name="TxtUsername" Height="40" Background="White" Foreground="Black" FontSize="16" BorderBrush="Black" BorderThickness="3" Padding="8" />

                    <Button x:Name="BtnSend" Content="{x:Static language:Resources.SendFriendRequest_SendButton}" Width="120" Height="36" HorizontalAlignment="Right" Margin="0,12,0,0" Background="#FFF36B" Foreground="Black" BorderThickness="0" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,3,0,0" Margin="0,6,0,6" />

                <StackPanel Grid.Row="3" Margin="4,12,4,4">
                    <TextBlock Text="{x:Static language:Resources.SendFriendRequest_RequestsSent}" FontSize="18" Foreground="#000" Margin="4,0,4,8" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="Black" BorderThickness="3" Background="#8A0000" Padding="8" Margin="0,6,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="44" Height="44" Fill="Black" Stroke="White" StrokeThickness="2" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="xX_Denis_Xx" Foreground="#000" FontSize="16" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="{x:Static language:Resources.Common_Button_Close}" Width="36" Height="36" Background="Transparent" BorderBrush="Black" BorderThickness="3" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
