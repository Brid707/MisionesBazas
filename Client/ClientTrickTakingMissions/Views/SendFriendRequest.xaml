<Page x:Class="View.Views.SendFriendRequest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="420"
      Title="SendFriendRequest">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStartColor}"
                              Offset="0.0" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep1Color}"
                              Offset="0.3" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep2Color}"
                              Offset="0.8" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientEndColor}"
                              Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                BorderThickness="3" Margin="12"
                Background="{x:Static styles:ColorPalette.LobbyContainerBackgroundBrush}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="Transparent" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Static language:Resources.SendFriendRequest_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Margin="0,8,0,8" />

                    <Button x:Name="CloseButton" Grid.Column="2" Width="44" Height="44"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent"
                            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                            BorderThickness="3" Cursor="Hand" Command="{Binding BackCommand}">
                        <TextBlock Text="✕"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="8,16,8,8">
                    <TextBlock Text="{x:Static language:Resources.SendFriendRequest_Information}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Margin="6,6,6,12" />

                    <TextBox x:Name="UsernameTextBox" Height="40"
                             Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                             Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                             BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                             BorderThickness="3" Padding="8"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <Button x:Name="SendButton"
                            Content="{x:Static language:Resources.SendFriendRequest_SendButton}"
                            Width="120" Height="36" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            BorderThickness="0"
                            Command="{Binding SendCommand}" />
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                        BorderThickness="0,3,0,0" Margin="0,6,0,6" />

                <StackPanel Grid.Row="3" Margin="4,12,4,4">
                    <TextBlock Text="{x:Static language:Resources.SendFriendRequest_RequestsSent}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               Margin="4,0,4,8" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                    BorderThickness="3"
                                    Background="{x:Static styles:ColorPalette.SidebarBackgroundBrush}"
                                    Padding="8" Margin="0,6,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="44" Height="44"
                                                 Fill="{x:Static styles:ColorPalette.PureBlackBrush}"
                                                 Stroke="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                                 StrokeThickness="2" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="xX_Denis_Xx"
                                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                   Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                                   FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="{x:Static language:Resources.Common_Button_Close}"
                                                Width="36" Height="36" Background="Transparent"
                                                BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                                BorderThickness="3"
                                                Command="{Binding CancelSentRequestCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
