<Window x:Class="View.Views.ForgotPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d" 
        d:DesignHeight="480" d:DesignWidth="820"
        Height="480" Width="820"
        Title="ForgotPassword" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushCompactDialogBackground}">

    <Grid>
        <Border x:Name="MainBorder" BorderThickness="3"
                BorderBrush="{StaticResource BrushTextDark}"
                Padding="12" Background="{StaticResource BrushTransparent}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="CloseButton" Content="{x:Static language:Resources.Common_Button_Close}"
                        Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource BrushBurgundyDark}"
                        Foreground="{StaticResource BrushTextDark}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontWeight="Bold"
                        FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                        BorderThickness="2"
                        BorderBrush="{StaticResource BrushTextDark}"
                        Command="{Binding CloseCommand}" />

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <TextBlock Text="{x:Static language:Resources.ForgotPassword_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{StaticResource BrushGoldAccent}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
                    <StackPanel>
                        <TextBlock Text="{x:Static language:Resources.ForgotPassword_Information}"
                                   Foreground="{StaticResource BrushTextDark}"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                   TextAlignment="Center" Margin="0,0,0,18" />

                        <TextBox x:Name="EmailTextBox" Width="640" Height="48"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BrushTextLight}"
                                 BorderBrush="{StaticResource BrushDarkText}"
                                 BorderThickness="4" Padding="8"
                                 FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                 FontSize="{x:Static styles:FontTypography.FormLabelFontSize}" />

                        <Button x:Name="SendButton"
                                Content="{x:Static language:Resources.ForgotPassword_Button}"
                                Width="200" Height="44"
                                Background="{StaticResource BrushGoldAccent}"
                                Foreground="{StaticResource BrushDarkText}"
                                FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                FontWeight="SemiBold" BorderThickness="0" Margin="0,24,0,0"
                                Command="{Binding SendCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Window>
