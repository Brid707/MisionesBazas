<Window x:Class="View.Views.HowToPlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.Views"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="{x:Static language:Resources.HowToPlay_Title}" Height="580" Width="720"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{x:Static styles:ColorPalette.SidebarBackgroundBrush}">
    <Grid>
        <Border x:Name="MainBorder" BorderThickness="3"
                BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                Padding="12" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,6,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" />

                    <Button x:Name="CloseButton" Grid.Column="2"
                            Content="{x:Static language:Resources.Common_Button_Close}"
                            Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontWeight="Bold"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            BorderThickness="2"
                            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                            Command="{Binding CloseCommand}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{x:Static styles:ColorPalette.DialogContainerBackgroundBrush}"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                        BorderThickness="2" CornerRadius="6" Padding="14,10,10,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="a." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleA}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="b." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleB}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="c." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleC}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="d." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleD}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="28,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="i." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static language:Resources.HowToPlay_RuleD_Sub1}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.LightBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="e." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleE}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="f." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleF}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="g." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static language:Resources.HowToPlay_RuleG}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.BodyFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="28,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="i." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static language:Resources.HowToPlay_RuleG_Sub1}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.LightBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="28,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ii." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static language:Resources.HowToPlay_RuleG_Sub2}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.LightBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="28,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="iii." FontWeight="Bold"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static language:Resources.HowToPlay_RuleG_Sub3}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                           Foreground="{x:Static styles:ColorPalette.LightBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Window>
