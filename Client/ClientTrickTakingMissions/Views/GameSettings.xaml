<Window x:Class="View.Views.GameSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.Views"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="GameSettings" Height="520" Width="420"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{x:Static styles:ColorPalette.SidebarBackgroundBrush}">
    <Grid>
        <Border x:Name="MainBorder" BorderThickness="3"
                BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                Padding="12" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="{x:Static language:Resources.GameSettings_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.MediumTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" />

                    <Button x:Name="CloseButton" Grid.Column="2"
                            Content="{x:Static language:Resources.Common_Button_Close}"
                            Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontWeight="Bold"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            BorderThickness="2"
                            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Width="360" Margin="0,12,0,0">
                    <StackPanel HorizontalAlignment="Left" Width="360">
                        <TextBlock Text="{x:Static language:Resources.GameSettings_NumberPlayers}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="PlayersComboBox" Width="160" Height="36"
                                  FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                  FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                  Margin="0,0,0,12" HorizontalAlignment="Left" />

                        <TextBlock Text="{x:Static language:Resources.GameSettings_Missions}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                                   Margin="0,6,0,6" />
                        <ComboBox x:Name="MissionsComboBox" Width="160" Height="36"
                                  FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                  FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                  Margin="0,0,0,12" HorizontalAlignment="Left" />

                        <TextBlock Text="{x:Static language:Resources.GameSettings_Privacy}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                                   Margin="0,6,0,6" />
                        <StackPanel Orientation="Vertical" Margin="8,6,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                <RadioButton x:Name="RadioPrivate" GroupName="Privacy"
                                             Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static language:Resources.GameSettings_PrivateRButton}"
                                           Foreground="{x:Static styles:ColorPalette.OptionLabelTextBrush}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                <RadioButton x:Name="RadioPublic" GroupName="Privacy"
                                             Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static language:Resources.GameSettings_PublicRButton}"
                                           Foreground="{x:Static styles:ColorPalette.OptionLabelTextBrush}"
                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="ConfirmButton"
                                Content="{x:Static language:Resources.GameSettings_ConfirmButton}"
                                Width="200" Height="48"
                                Background="{x:Static styles:ColorPalette.SuccessAlternativeButtonBackgroundBrush}"
                                Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                                FontWeight="SemiBold" BorderThickness="0" Margin="0,18,0,0"
                                HorizontalAlignment="Center" Click="ConfirmButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Window>
