<Page x:Class="View.Views.RecoverPassword"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="420" d:DesignWidth="820"
      Background="{x:Static styles:ColorPalette.CompactDialogBackgroundBrush}"
      Title="RecoverPassword">

    <Border BorderThickness="3"
            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
            Padding="12" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button x:Name="BtnBack" Content="{x:Static language:Resources.Common_Button_Back}"
                        Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                        FontWeight="Bold" FontSize="18" BorderThickness="2"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                        Click="BtnBack_Click" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="{x:Static language:Resources.RecoverPassword_Title}"
                               FontFamily="Impact" FontSize="34"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Button x:Name="BtnClose" Content="{x:Static language:Resources.Common_Button_Close}"
                        Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                        FontWeight="Bold" FontSize="18" BorderThickness="2"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                        Click="BtnClose_Click" />
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Width="760" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,0,8" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static language:Resources.RecoverPassword_EmailSend}"
                               Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                               FontSize="16" VerticalAlignment="Center" />
                    <Border Width="28" Height="28"
                            Background="{x:Static styles:ColorPalette.InviteButtonBackgroundBrush}"
                            CornerRadius="4" Margin="8,0,0,0"
                            BorderBrush="{x:Static styles:ColorPalette.DarkTextBrush}"
                            BorderThickness="2">
                        <TextBlock Text="✔" Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                   FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBox x:Name="EmailTextBox" Width="640" Height="42"
                         Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                         BorderBrush="{x:Static styles:ColorPalette.DarkTextBrush}"
                         BorderThickness="4" Padding="8" FontSize="16"
                         IsReadOnly="True" HorizontalAlignment="Center" />

                <Button x:Name="ResendButton"
                        Content="{x:Static language:Resources.RecoverPassword_ResendCode}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{x:Static styles:ColorPalette.AccentLinkTextBrush}"
                        FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,12"
                        Click="ResendButton_Click" />

                <TextBlock Text="{x:Static language:Resources.RecoverPassword_Information}"
                           Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                           FontSize="16" TextAlignment="Center" Margin="0,0,0,8"
                           HorizontalAlignment="Center" />

                <TextBox x:Name="CodeTextBox" Width="640" Height="44"
                         Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                         BorderBrush="{x:Static styles:ColorPalette.DarkTextBrush}"
                         BorderThickness="4" Padding="8" FontSize="16"
                         HorizontalAlignment="Center" />

                <Button x:Name="ConfirmButton"
                        Content="{x:Static language:Resources.RecoverPassword_ConfirmButton}"
                        Width="200" Height="44"
                        Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                        FontSize="18" FontWeight="SemiBold" BorderThickness="0" Margin="0,16,0,0"
                        Click="ConfirmButton_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Page>
