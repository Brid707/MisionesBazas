<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:language="clr-namespace:View.Properties.Langs"
    xmlns:styles="clr-namespace:View.Styles"
    x:Class="View.Views.LoginPage"
    mc:Ignorable="d"
    d:DesignHeight="768"
    d:DesignWidth="1365"
    Title="LoginPage">
    <Grid Background="{StaticResource BrushTextDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*"/>
            <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BrushBurgundySurface}"/>
        <Viewbox Grid.ColumnSpan="2" Stretch="Uniform">
            <Grid Width="1365" Height="768" Background="{StaticResource BrushTransparent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.45*"/>
                    <ColumnDefinition Width="0.55*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BrushTransparent}">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="36,0,90,0"
                            Width="480">
                            <ContentControl
                                Content="{x:Static language:Resources.Common_GameTitle_Title}"
                                ContentTemplate="{StaticResource GameTitleTemplate}"
                                Height="230"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Background="{StaticResource BrushTransparent}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="BackButton"
                        Content="{x:Static language:Resources.Common_Button_Back}"
                        Width="40"
                        Height="40"
                        Margin="90,12,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                        Command="{Binding BackCommand}"/>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <TextBlock
                            x:Name="LoginTitleTextBlock"
                            Text="{x:Static language:Resources.Login_LoginTitle}"
                            Foreground="{StaticResource BrushTextLight}"
                            FontFamily="{x:Static styles:FontTypography.AuthenticationHeadingFontFamily}"
                            FontSize="{x:Static styles:FontTypography.AuthenticationHeadingFontSize}"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            Margin="0,0,0,18"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Login_Email}"
                            Foreground="{StaticResource BrushTextLight}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                            Margin="6,0,0,6"/>
                        <TextBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="EmailTextBox"
                            Height="56"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="12"
                            Margin="0,0,0,12"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Login_Password}"
                            Foreground="{StaticResource BrushTextLight}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                            Margin="6,0,0,6"/>
                        <PasswordBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="PasswordBox"
                            Height="56"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="12"
                            Margin="0,0,0,8"
                            PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock
                            Text="{Binding AccountBanFeedbackText}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,12"
                            Foreground="{StaticResource BrushGoldAccent}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"/>
                        <Button
                            x:Name="LoginButton"
                            Style="{StaticResource AuthSubmitButtonStyle}"
                            Content="{x:Static language:Resources.Login_Enter}"
                            Height="64"
                            Width="220"
                            Background="{StaticResource BrushSubmitButtonBackground}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.PrimaryActionFontSize}"
                            FontWeight="Bold"
                            Command="{Binding LoginCommand}"/>
                        <Button
                            x:Name="ForgotPasswordButton"
                            Content="{x:Static language:Resources.Login_ForgotPassword}"
                            Height="32"
                            Width="220"
                            Background="{StaticResource BrushTransparent}"
                            Foreground="{StaticResource BrushSecondaryButtonBackground}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Command="{Binding ForgotPasswordCommand}"/>
                    </StackPanel>
                </Grid>
                <Border
                    Grid.ColumnSpan="2"
                    Panel.ZIndex="1"
                    Width="180"
                    Height="768"
                    HorizontalAlignment="Left"
                    Margin="520,0,0,0"
                    Style="{StaticResource CardStripDecorationStyle}"/>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
