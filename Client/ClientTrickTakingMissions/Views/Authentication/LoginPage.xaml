<Page x:Class="View.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="LoginPage">

    <Grid Background="{StaticResource BrushTextDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*" />
            <ColumnDefinition Width="0.55*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientStart}"
                                  Offset="0" />
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientStep}"
                                  Offset="0.5" />
                    <GradientStop Color="{StaticResource ColorAuthBackgroundGradientEnd}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="40,0,0,120" Width="500">
                    <Viewbox MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock x:Name="TitleTextBlock" Text="{x:Static language:Resources.Login_Title}"
                                   Foreground="{StaticResource BrushGoldAccent}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="{x:Static styles:FontTypography.DisplayTitleFontSize}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left" />
                    </Viewbox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BrushTextDark}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BackButton" Content="{x:Static language:Resources.Common_Button_Back}"
                    Width="40" Height="40" Margin="12" HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                    FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                    Command="{Binding BackCommand}" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock x:Name="LoginTitleTextBlock"
                           Text="{x:Static language:Resources.Login_LoginTitle}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                           FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                           FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,18" />

                <TextBlock Text="{x:Static language:Resources.Login_Email}"
                           Foreground="{StaticResource BrushTextLight}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                           Margin="6,0,0,6" />
                <TextBox x:Name="EmailTextBox" Height="56"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                         FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                         Padding="12" Margin="0,0,0,12" />

                <TextBlock Text="{x:Static language:Resources.Login_Password}"
                           Foreground="{StaticResource BrushTextLight}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                           FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                           Margin="6,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="56"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                             Padding="12" Margin="0,0,0,8"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <Button x:Name="ForgotPasswordButton"
                        Content="{x:Static language:Resources.Login_ForgotPassword}"
                        Height="32" Width="220" Background="{StaticResource BrushTransparent}"
                        Foreground="{StaticResource BrushGoldAccent}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                        BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,12"
                        Command="{Binding ForgotPasswordCommand}" />

                <TextBlock Text="{Binding AccountBanFeedbackText}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource BrushGoldAccent}"
                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}" />

                <Button x:Name="LoginButton" Content="{x:Static language:Resources.Login_Enter}"
                        Height="64" Width="220"
                        Background="{StaticResource BrushSubmitButtonBackground}"
                        Foreground="{StaticResource BrushTextDark}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.PrimaryActionFontSize}"
                        FontWeight="Bold"
                        Command="{Binding LoginCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
