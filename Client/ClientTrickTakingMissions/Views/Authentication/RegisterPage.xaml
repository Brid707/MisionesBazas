<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:language="clr-namespace:View.Properties.Langs"
    xmlns:styles="clr-namespace:View.Styles"
    x:Class="View.Views.RegisterPage"
    mc:Ignorable="d"
    d:DesignHeight="768"
    d:DesignWidth="1365"
    Title="{x:Static language:Resources.Register_Title}">
    <Grid Background="{StaticResource BrushTextDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*"/>
            <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BrushBurgundySurface}"/>
        <Viewbox Grid.ColumnSpan="2" Stretch="Uniform">
            <Grid Width="1365" Height="768" Background="{StaticResource BrushTransparent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.45*"/>
                    <ColumnDefinition Width="0.55*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BrushTransparent}">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="36,0,90,0"
                            Width="480">
                            <ContentControl
                                Content="{x:Static language:Resources.Common_GameTitle_Title}"
                                ContentTemplate="{StaticResource GameTitleTemplate}"
                                Height="230"/>
                            <TextBlock
                                x:Name="RestrictionsTextBlock"
                                Text="{x:Static language:Resources.Register_Restrictions}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource BrushGoldAccent}"
                                Margin="0,28,0,0"
                                FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Background="{StaticResource BrushTransparent}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button
                            x:Name="BackButton"
                            Content="{x:Static language:Resources.Common_Button_Back}"
                            Width="48"
                            Height="48"
                            Margin="90,12,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Command="{Binding BackCommand}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <TextBlock
                            Text="{x:Static language:Resources.Register_Title}"
                            TextAlignment="Center"
                            Foreground="{StaticResource BrushTextLight}"
                            Margin="0,0,0,24"
                            FontFamily="{x:Static styles:FontTypography.AuthenticationHeadingFontFamily}"
                            FontSize="{x:Static styles:FontTypography.AuthenticationHeadingFontSize}"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Register_Email}"
                            Foreground="{StaticResource BrushGoldAccent}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            Margin="0,0,0,4"/>
                        <TextBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="EmailTextBox"
                            Height="50"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="8"
                            Margin="0,0,0,12"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Register_Username}"
                            Foreground="{StaticResource BrushGoldAccent}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            Margin="0,0,0,4"/>
                        <TextBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="UsernameTextBox"
                            Height="50"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="8"
                            Margin="0,0,0,12"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Register_Password}"
                            Foreground="{StaticResource BrushGoldAccent}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            Margin="0,0,0,4"/>
                        <PasswordBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="PasswordBox"
                            Height="50"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="8"
                            Margin="0,0,0,12"
                            PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock
                            Text="{x:Static language:Resources.Register_ConfirmPassword}"
                            Foreground="{StaticResource BrushGoldAccent}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            Margin="0,0,0,4"/>
                        <PasswordBox
                            Style="{StaticResource AuthInputStyle}"
                            x:Name="ConfirmPasswordBox"
                            Height="50"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            Padding="8"
                            Margin="0,0,0,18"
                            PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        <Button
                            x:Name="SubmitButton"
                            Style="{StaticResource AuthSubmitButtonStyle}"
                            Content="{x:Static language:Resources.Register_SubmitButton}"
                            Height="64"
                            Width="220"
                            Background="{StaticResource BrushSubmitButtonBackground}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.PrimaryActionFontSize}"
                            FontWeight="Bold"
                            Command="{Binding SubmitCommand}"/>
                    </StackPanel>
                </Grid>
                <Border
                    Grid.ColumnSpan="2"
                    Panel.ZIndex="1"
                    Width="180"
                    Height="768"
                    HorizontalAlignment="Left"
                    Margin="520,0,0,0"
                    Style="{StaticResource CardStripDecorationStyle}"/>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
