<Window x:Class="View.Views.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="ChangePassword" Height="380" Width="640"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource BrushTransparent}"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="{StaticResource BrushTextDark}"
            BorderThickness="3" CornerRadius="4" Background="{StaticResource BrushTransparent}" Padding="8">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource ColorModalAccentGradientStart}"
                                  Offset="0" />
                    <GradientStop Color="{StaticResource ColorModalAccentGradientEnd}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{StaticResource BrushTextDark}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />

                    <Button x:Name="CloseTopButton" Width="40" Height="40"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource BrushBurgundyDark}"
                            BorderBrush="{StaticResource BrushTextDark}"
                            BorderThickness="2"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="✕"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                   Foreground="{StaticResource BrushTextDark}"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="16"
                            HorizontalAlignment="Center" Width="520">
                    <TextBlock Text="{x:Static language:Resources.ChangePassword_Information}"
                               Foreground="{StaticResource BrushTextDark}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                               Margin="4" />

                    <PasswordBox x:Name="NewPasswordBox" Height="56"
                                 Background="{StaticResource BrushInputFieldBackground}"
                                 BorderBrush="{StaticResource BrushInputFieldBorder}"
                                 BorderThickness="2"
                                 FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                 FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                 Padding="8" Margin="0,12,0,8"
                                 Foreground="{StaticResource BrushTextDark}"
                                 PasswordChanged="NewPasswordBox_PasswordChanged" />

                    <PasswordBox x:Name="ConfirmPasswordBox" Height="56"
                                 Background="{StaticResource BrushInputFieldBackground}"
                                 BorderBrush="{StaticResource BrushInputFieldBorder}"
                                 BorderThickness="2"
                                 FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                 FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                 Padding="8" Margin="0,8,0,16"
                                 Foreground="{StaticResource BrushTextDark}"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                    <Button x:Name="ConfirmButton"
                            Content="{x:Static language:Resources.ChangePassword_ConfirmButton}"
                            Width="180" Height="44"
                            Background="{StaticResource BrushGoldAccent}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                            FontWeight="SemiBold" BorderThickness="0"
                            HorizontalAlignment="Center"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
