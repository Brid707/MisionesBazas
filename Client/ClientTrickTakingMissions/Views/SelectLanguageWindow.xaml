<Window x:Class="View.Views.SelectLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        Title="{x:Static language:Resources.SelectLanguage_Title}" Height="220" Width="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushCompactDialogBackground}"
        AllowsTransparency="False">

    <Border BorderThickness="3"
            BorderBrush="{StaticResource BrushTextDark}"
            Padding="12" Background="{StaticResource BrushTransparent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="CloseButton" Content="{x:Static language:Resources.Common_Button_Close}"
                    Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{StaticResource BrushBurgundyDark}"
                    Foreground="{StaticResource BrushTextDark}"
                    FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                    FontWeight="Bold"
                    FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                    BorderThickness="2"
                    BorderBrush="{StaticResource BrushTextDark}"
                    Command="{Binding CloseCommand}" />

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,6">
                <TextBlock Text="{x:Static language:Resources.SelectLanguage_Title}"
                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                           FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                           Foreground="{StaticResource BrushGoldAccent}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="SpanishButton" Width="200" Height="64"
                        Background="{StaticResource BrushGoldAccent}"
                        Foreground="{StaticResource BrushDarkText}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                        FontWeight="SemiBold" Margin="0,0,12,0"
                        Content="{x:Static language:Resources.SelectLanguage_SpanishButton}"
                        Command="{Binding SelectSpanishCommand}" />
                <Button x:Name="EnglishButton" Width="200" Height="64"
                        Background="{StaticResource BrushGoldAccent}"
                        Foreground="{StaticResource BrushDarkText}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                        FontWeight="SemiBold" Margin="12,0,0,0"
                        Content="{x:Static language:Resources.SelectLanguage_EnglishButton}"
                        Command="{Binding SelectEnglishCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
