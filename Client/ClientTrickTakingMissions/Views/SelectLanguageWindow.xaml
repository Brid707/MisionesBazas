<Window x:Class="View.Views.SelectLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        Title="{x:Static language:Resources.SelectLanguage_Title}" Height="220" Width="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static styles:ColorPalette.CompactDialogBackgroundBrush}"
        AllowsTransparency="False">

    <Border BorderThickness="3"
            BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
            Padding="12" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BtnClose" Content="{x:Static language:Resources.Common_Button_Close}"
                    Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                    Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                    FontWeight="Bold" FontSize="18" BorderThickness="2"
                    BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                    Click="BtnClose_Click" />

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,6">
                <TextBlock Text="{x:Static language:Resources.SelectLanguage_Title}"
                           FontFamily="Impact" FontSize="32"
                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="BtnSpanish" Width="200" Height="64"
                        Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                        FontSize="20" FontWeight="SemiBold" Click="BtnSpanish_Click" Margin="0,0,12,0"
                        Content="{x:Static language:Resources.SelectLanguage_SpanishButton}" />
                <Button x:Name="BtnEnglish" Width="200" Height="64"
                        Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                        FontSize="20" FontWeight="SemiBold" Click="BtnEnglish_Click" Margin="12,0,0,0"
                        Content="{x:Static language:Resources.SelectLanguage_EnglishButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
