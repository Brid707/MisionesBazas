<Window x:Class="View.Views.ManageFriendRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:controls="clr-namespace:View.Controls"
             xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="ManageFriendRequestWindow"
        Height="550" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource BrushTransparent}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushTextDark}" BorderThickness="3">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource ColorDialogBackgroundGradientStart}"
                                  Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorDialogBackgroundGradientStep1}"
                                  Offset="0.25" />
                    <GradientStop Color="{StaticResource ColorDialogBackgroundGradientStep2}"
                                  Offset="0.6" />
                    <GradientStop Color="{StaticResource ColorDialogBackgroundGradientEnd}"
                                  Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BrushTextDark}"
                    BorderThickness="0,0,0,3"
                    Background="{StaticResource BrushDialogHeaderBackground}">
                <Grid Margin="12,10,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" />

                    <TextBlock
                               Text="{x:Static language:Resources.ManageFriendRequest_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{StaticResource BrushGoldAccent}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               LineHeight="34" />

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Width="38" Height="38"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource BrushTransparent}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                        <Grid Width="36" Height="36">
                            <Ellipse Stroke="{StaticResource BrushTextDark}"
                                     StrokeThickness="3.5" Fill="{StaticResource BrushTransparent}" />
                            <TextBlock Text="ÃƒÂ¢Ã…â€œÃ¢â‚¬Â¢"
                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                       FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextDark}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RequestsContainer">
                    <ItemsControl x:Name="PendingRequestsItemsControl"
                                  ItemsSource="{Binding PendingRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushTextDark}"
                                        BorderThickness="0,0,0,3"
                                        Background="{StaticResource BrushRequestCardBackground}"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Width="48" Height="48" Margin="0,0,8,0"
                                                Style="{StaticResource PlayerProfileLinkButtonStyle}"
                                                Command="{Binding DataContext.PlayerProfiles.OpenByUserIdCommand, Mode=OneWay,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding SenderUserId, Mode=OneWay}">
                                            <controls:PlayerProfileAvatar Width="44" Height="44"
                                                ProfileOwnerUserId="{Binding SenderUserId, Mode=OneWay}" />
                                        </Button>

                                        <Button Grid.Column="1" Style="{StaticResource PlayerProfileLinkButtonStyle}"
                                                        Command="{Binding DataContext.PlayerProfiles.OpenByUserIdCommand, Mode=OneWay,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SenderUserId, Mode=OneWay}">
                                                    <TextBlock Grid.Column="1"
                                                   Text="{Binding SenderUsername}"
                                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                   FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextDark}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,8,0"
                                                   TextTrimming="CharacterEllipsis" />
                                                </Button>

                                        <Button Grid.Column="2"
                                                Width="38" Height="38"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource BrushTransparent}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="{x:Static language:Resources.ManageFriendRequest_Tooltip_Accept}"
                                                Command="{Binding DataContext.AcceptRequestCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="36" Height="36">
                                                <Ellipse Stroke="{StaticResource BrushTextDark}"
                                                         StrokeThickness="3.5" Fill="{StaticResource BrushTransparent}" />
                                                <Path Data="M 9 18 L 15 24 L 27 11"
                                                      Stroke="{StaticResource BrushTextDark}"
                                                      StrokeThickness="3.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top" />
                                            </Grid>
                                        </Button>

                                        <Button Grid.Column="3"
                                                Width="38" Height="38"
                                                Background="{StaticResource BrushTransparent}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="{x:Static language:Resources.ManageFriendRequest_Tooltip_Reject}"
                                                Command="{Binding DataContext.RejectRequestCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="36" Height="36">
                                                <Ellipse Stroke="{StaticResource BrushTextDark}"
                                                         StrokeThickness="3.5" Fill="{StaticResource BrushTransparent}" />
                                                <Path Data="M 11 11 L 25 25 M 25 11 L 11 25"
                                                      Stroke="{StaticResource BrushTextDark}"
                                                      StrokeThickness="3.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Message when there are no requests -->
                    <TextBlock x:Name="TxtNoRequests"
                               Text="{x:Static language:Resources.ManageFriendRequest_Label_NoPendingRequests}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushEmptyStateText}"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="{Binding HasNoPendingRequests,
                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
