<Page x:Class="View.Views.SendFriendRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:language="clr-namespace:View.Properties.Langs"
      xmlns:controls="clr-namespace:View.Controls"
      xmlns:styles="clr-namespace:View.Styles"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="420"
      Title="SendFriendRequestPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource ColorWindowBackgroundGradientStart}"
                              Offset="0.0" />
                <GradientStop Color="{StaticResource ColorWindowBackgroundGradientStep1}"
                              Offset="0.3" />
                <GradientStop Color="{StaticResource ColorWindowBackgroundGradientStep2}"
                              Offset="0.8" />
                <GradientStop Color="{StaticResource ColorWindowBackgroundGradientEnd}"
                              Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="{StaticResource BrushTextDark}"
                BorderThickness="3" Margin="12"
                Background="{StaticResource BrushLobbyContainerBackground}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="{StaticResource BrushTransparent}" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Static language:Resources.SendFriendRequest_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                               Foreground="{StaticResource BrushGoldAccent}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Margin="0,8,0,8" />

                    <Button x:Name="CloseButton" Grid.Column="2" Width="44" Height="44"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource BrushTransparent}"
                            BorderBrush="{StaticResource BrushTextDark}"
                            BorderThickness="3" Cursor="Hand" Command="{Binding BackCommand}">
                        <TextBlock Text="ÃƒÂ¢Ã…â€œÃ¢â‚¬Â¢"
                                   FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="8,16,8,8">
                    <TextBlock Text="{x:Static language:Resources.SendFriendRequest_Information}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                               Foreground="{StaticResource BrushTextDark}"
                               Margin="6,6,6,12" />

                    <TextBox x:Name="UsernameTextBox" Height="40"
                             Background="{StaticResource BrushTextLight}"
                             Foreground="{StaticResource BrushTextDark}"
                             FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                             FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                             BorderBrush="{StaticResource BrushTextDark}"
                             BorderThickness="3" Padding="8"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <Button x:Name="PreviewPlayerProfileButton" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Style="{StaticResource ProfileActionButtonStyle}"
                            Content="{x:Static language:PlayerProfileResources.Profile_ViewPublicProfile}"
                            Command="{Binding PlayerProfiles.OpenByUsernameCommand, Mode=OneWay}"
                            CommandParameter="{Binding Username}" />

                    <Button x:Name="SendButton"
                            Content="{x:Static language:Resources.SendFriendRequest_SendButton}"
                            Width="120" Height="36" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Background="{StaticResource BrushGoldAccent}"
                            Foreground="{StaticResource BrushTextDark}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            BorderThickness="0"
                            Command="{Binding SendCommand}" />
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BrushTextDark}"
                        BorderThickness="0,3,0,0" Margin="0,6,0,6" />

                <Grid Grid.Row="3" Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{x:Static language:Resources.SendFriendRequest_RequestsSent}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                               FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                               Foreground="{StaticResource BrushTextDark}"
                               Margin="4,0,4,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SentRequestsItemsControl"
                                      ItemsSource="{Binding SentRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushTextDark}"
                                            BorderThickness="3"
                                            Background="{StaticResource BrushBurgundySurface}"
                                            Padding="8" Margin="0,6,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Width="48" Height="48" Margin="0,0,8,0"
                                                Style="{StaticResource PlayerProfileLinkButtonStyle}"
                                                Command="{Binding DataContext.PlayerProfiles.OpenByUserIdCommand, Mode=OneWay,
                                                    RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding ReceiverUserId, Mode=OneWay}">
                                            <controls:PlayerProfileAvatar Width="44" Height="44"
                                                ProfileOwnerUserId="{Binding ReceiverUserId, Mode=OneWay}" />
                                        </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PlayerProfileLinkButtonStyle}"
                                                        Command="{Binding DataContext.PlayerProfiles.OpenByUserIdCommand, Mode=OneWay,
                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding ReceiverUserId, Mode=OneWay}">
                                                    <TextBlock Text="{Binding ReceiverUsername}"
                                                           FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                           Foreground="{StaticResource BrushTextDark}"
                                                           FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                                           VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Content="{x:Static language:Resources.Common_Button_Close}"
                                                        Width="36" Height="36" Background="{StaticResource BrushTransparent}"
                                                        BorderBrush="{StaticResource BrushTextDark}"
                                                        BorderThickness="3"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.CancelSentRequestCommand,
                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
