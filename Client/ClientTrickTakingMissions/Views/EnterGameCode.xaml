<Window x:Class="View.Views.EnterGameCode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.Views"
        xmlns:language="clr-namespace:View.Properties.Langs"
        xmlns:styles="clr-namespace:View.Styles"
        mc:Ignorable="d"
        Title="EnterGameCode" Height="286" Width="820"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{x:Static styles:ColorPalette.SidebarBackgroundBrush}">
    <Grid>
        <Border x:Name="MainBorder" BorderThickness="3"
                BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                Padding="12" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="CloseButton" Content="{x:Static language:Resources.Common_Button_Close}"
                        Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{x:Static styles:ColorPalette.DarkButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                        FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                        FontWeight="Bold"
                        FontSize="{x:Static styles:FontTypography.SecondaryButtonFontSize}"
                        BorderThickness="2"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                        Click="CloseButton_Click" />

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <TextBlock Text="{x:Static language:Resources.EnterGameCode_Title}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.LargeTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBox x:Name="CodeTextBox" Width="640" Height="56"
                                 Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                                 BorderBrush="{x:Static styles:ColorPalette.DarkTextBrush}"
                                 BorderThickness="4" Padding="8"
                                 FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                 FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}" />

                        <Button x:Name="EnterButton"
                                Content="{x:Static language:Resources.EnterGameCode_JoinButton}"
                                Width="200" Height="52"
                                Background="{x:Static styles:ColorPalette.SuccessAlternativeButtonBackgroundBrush}"
                                Foreground="{x:Static styles:ColorPalette.PureBlackBrush}"
                                FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                                FontWeight="SemiBold" BorderThickness="0" Margin="0,24,0,0"
                                Click="EnterButton_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
    </Grid>
</Window>
