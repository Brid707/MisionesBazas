<Page x:Class="View.Views.GameMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:views="clr-namespace:View.Views"
      xmlns:styles="clr-namespace:View.Styles"
      xmlns:language="clr-namespace:View.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="GameMenu">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStartColor}" Offset="0.0" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep1Color}" Offset="0.3" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep2Color}" Offset="0.8" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientEndColor}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Button x:Name="ProfileButton"
                    Width="64" Height="64" Margin="40,30,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="ProfileButton_Click"
                    ToolTip="{x:Static language:Resources.GameMenu_Profile}">
                <Grid Width="56" Height="56">
                    <Ellipse Fill="Black" Width="56" Height="56" />
                    <Ellipse Fill="White" Width="18" Height="18" Margin="0,10,0,0" VerticalAlignment="Top" />
                    <Path Fill="White" Data="M 12 46 C 12 34 20 30 28 30 C 36 30 44 34 44 46 Z" />
                </Grid>
            </Button>

            <Button x:Name="TrophyButton"
                    Width="44" Height="44"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,120,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="TrophyButton_Click"
                    ToolTip="{x:Static language:Resources.GameMenu_Tooltip_ScoreBoard}">
                <TextBlock Text="🏆" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="GameTitleTextBlock"
                           Text="{x:Static language:Resources.GameMenu_Title}"
                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                           FontFamily="Impact, Arial Black, 'Segoe UI'"
                           FontWeight="Bold"
                           FontSize="78"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,44" />

                <StackPanel HorizontalAlignment="Center" Width="440">
                    <Button x:Name="CreateRoomButton"
                            Content="{x:Static language:Resources.GameMenu_CreateRoom}"
                            Width="440" Height="72"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0" Margin="0,0,0,24"
                            Click="CreateRoomButton_Click" />

                    <Button x:Name="JoinLobbyButton"
                            Content="{x:Static language:Resources.GameMenu_JoinLobby}"
                            Width="440" Height="72"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0" Margin="0,0,0,24"
                            Click="JoinLobbyButton_Click" />

                    <Button x:Name="HowToPlayButton"
                            Content="{x:Static language:Resources.GameMenu_HowToPlay}"
                            Width="440" Height="72"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                            FontSize="22" FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="HowToPlayButton_Click" />

                    <Button x:Name="SignOutButton"
                            Content="{x:Static language:Resources.GameMenu_SignOut}"
                            Width="440" Height="72"
                            Background="{x:Static styles:ColorPalette.DangerButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                            FontSize="18" FontWeight="SemiBold"
                            BorderThickness="2" Margin="0,24,0,0"
                            Click="SignOutButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Dynamic Friends Sidebar Component -->
        <views:FriendsView Grid.Column="1" />
    </Grid>
</Page>
