<Page x:Class="View.Views.Lobby"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:View.Views"
      xmlns:styles="clr-namespace:View.Styles"
      xmlns:language="clr-namespace:View.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="Lobby">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStartColor}" Offset="0.0" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep1Color}" Offset="0.3" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientStep2Color}" Offset="0.8" />
                <GradientStop Color="{x:Static styles:ColorPalette.WindowBackgroundGradientEndColor}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Main Lobby Content -->
        <Grid Grid.Column="0" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BackButton"
                    Width="56" Height="56"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12,12,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click">
                <Canvas Width="40" Height="40">
                    <Path Stroke="Black" StrokeThickness="5" Data="M 30 6 L 10 20 L 30 34" Fill="Transparent" />
                </Canvas>
            </Button>

            <Button x:Name="ProfileButton"
                    Width="56" Height="56"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="80,12,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="ProfileButton_Click">
                <Grid Width="56" Height="56">
                    <Ellipse Fill="Black" Width="56" Height="56" />
                    <Ellipse Fill="White" Width="18" Height="18" Margin="0,10,0,0" VerticalAlignment="Top" />
                    <Path Fill="White" Data="M 12 46 C 12 34 20 30 28 30 C 36 30 44 34 44 46 Z" />
                </Grid>
            </Button>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="{x:Static language:Resources.Lobby_Title1}"
                           FontFamily="Impact, Arial Black, 'Segoe UI'"
                           FontSize="80"
                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{x:Static language:Resources.Lobby_Title2}"
                           FontFamily="Impact, Arial Black, 'Segoe UI'"
                           FontSize="66"
                           Foreground="{x:Static styles:ColorPalette.SecondaryTitleTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,-28,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static language:Resources.Lobby_Missions}"
                               FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontSize="20"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                    <TextBlock Text="5"
                               FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontSize="20"
                               Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                               Margin="6,0,24,0" />

                    <TextBlock Text="{x:Static language:Resources.Lobby_Code}"
                               FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontSize="20"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                    <TextBlock Text="XXXXX"
                               FontFamily="Impact, Arial Black, 'Segoe UI'"
                               FontSize="20"
                               Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                               Margin="6,0,24,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Content="{x:Static language:Resources.Lobby_SettingsButton}"
                        Width="140" Height="36"
                        Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                        Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                        FontSize="16" BorderThickness="0"
                        HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="Black"
                    BorderThickness="4"
                    Margin="12,12,12,12"
                    Padding="8"
                    Background="{x:Static styles:ColorPalette.LobbyContainerBackgroundBrush}">
                <StackPanel>
                    <Border BorderBrush="Black"
                            BorderThickness="3"
                            Margin="0,6,0,6"
                            Padding="8"
                            Background="{x:Static styles:ColorPalette.PlayerSlotBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="44" Height="44" Fill="Black" Stroke="White" StrokeThickness="2" />
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0">
                                <TextBlock Text="xX_Samuel_Xx"
                                           Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  👑"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="{x:Static language:Resources.Common_Button_Close}"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        BorderBrush="Black"
                                        BorderThickness="3"
                                        FontSize="18" />
                                <Button x:Name="ReadyButton"
                                        Content="{x:Static language:Resources.Lobby_ReadyButton}"
                                        Width="72" Height="36" Margin="8,0,0,0"
                                        Background="{x:Static styles:ColorPalette.SuccessButtonBackgroundBrush}"
                                        Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                        BorderBrush="Black" BorderThickness="2"
                                        RenderTransformOrigin="-5.707,35.478" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Player 2 - not ready -->
                    <Border BorderBrush="Black"
                            BorderThickness="3"
                            Margin="0,6,0,6"
                            Padding="8"
                            Background="{x:Static styles:ColorPalette.PlayerSlotBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="44" Height="44" Fill="Black" Stroke="White" StrokeThickness="2" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="xX_TheFatBv_Xx"
                                           Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                           FontSize="16" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="⋯"
                                        Width="44" Height="44"
                                        Background="Black" Foreground="White"
                                        BorderBrush="Black" BorderThickness="3"
                                        FontSize="18" />
                                <TextBlock Text="{x:Static language:Resources.Lobby_NotReadyButton}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="{x:Static styles:ColorPalette.DarkTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty slots -->
                    <Border BorderBrush="Black"
                            BorderThickness="3"
                            Margin="0,6,0,6"
                            Padding="8"
                            Background="{x:Static styles:ColorPalette.PlayerSlotBackgroundBrush}"
                            Height="72">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="44" Height="44" Fill="Black" Stroke="White" StrokeThickness="2" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="＋"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        BorderBrush="Black"
                                        BorderThickness="3"
                                        FontSize="20" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="Black"
                            BorderThickness="3"
                            Margin="0,6,0,6"
                            Padding="8"
                            Background="{x:Static styles:ColorPalette.PlayerSlotBackgroundBrush}"
                            Height="72">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="44" Height="44" Fill="Black" Stroke="White" StrokeThickness="2" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="＋"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        BorderBrush="Black"
                                        BorderThickness="3"
                                        FontSize="20" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dynamic Friends Sidebar Component -->
        <local:FriendsView Grid.Column="1" IsInLobby="True" />
    </Grid>
</Page>
