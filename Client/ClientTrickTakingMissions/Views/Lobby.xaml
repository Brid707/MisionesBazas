<Page x:Class="View.Views.Lobby"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:View.Views"
      xmlns:styles="clr-namespace:View.Styles"
      xmlns:language="clr-namespace:View.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1365"
      Title="Lobby">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="LobbyAvatarTemplate">
            <Grid Width="50" Height="50">
                <Ellipse Fill="{x:Static styles:ColorPalette.PureBlackBrush}" />
                <Ellipse Width="17" Height="17" Margin="0,8,0,0" VerticalAlignment="Top"
                         Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
                <Path Data="M 10 43 C 10 29 40 29 40 43 Q 25 53 10 43"
                      Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{x:Static styles:ColorPalette.LobbyBackgroundGradientStartColor}"
                              Offset="0.0" />
                <GradientStop Color="{x:Static styles:ColorPalette.LobbyBackgroundGradientEndColor}"
                              Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Main Lobby Content -->
        <Grid Grid.Column="0" Margin="120,12,70,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="210" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BackButton"
                    Width="56" Height="56"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding BackCommand}">
                <Canvas Width="40" Height="40">
                    <Path Stroke="{x:Static styles:ColorPalette.PureBlackBrush}"
                          StrokeThickness="5" Data="M 30 6 L 10 20 L 30 34" Fill="Transparent" />
                </Canvas>
            </Button>

            <Button x:Name="ProfileButton"
                    Width="56" Height="56"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="76,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding ProfileCommand}">
                <Grid Width="56" Height="56">
                    <Ellipse Fill="{x:Static styles:ColorPalette.PureBlackBrush}" Width="56" Height="56" />
                    <Ellipse Fill="{x:Static styles:ColorPalette.PureWhiteBrush}"
                             Width="18" Height="18" Margin="0,10,0,0" VerticalAlignment="Top" />
                    <Path Fill="{x:Static styles:ColorPalette.PureWhiteBrush}"
                          Data="M 12 46 C 12 34 20 30 28 30 C 36 30 44 34 44 46 Z" />
                </Grid>
            </Button>

            <Viewbox Grid.Row="0" MaxWidth="600" MaxHeight="190" HorizontalAlignment="Center"
                     VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static language:Resources.Lobby_Title1}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.HeroTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="{x:Static language:Resources.Lobby_Title2}"
                               FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                               FontSize="{x:Static styles:FontTypography.DisplayTitleFontSize}"
                               Foreground="{x:Static styles:ColorPalette.SecondaryTitleTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,-28,0,0" />
                </StackPanel>
            </Viewbox>

            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static language:Resources.Lobby_Missions}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                        <TextBlock Text="{Binding MissionsTarget}" Margin="8,0,0,0"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static language:Resources.Lobby_Code}"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}"
                                   Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}" />
                        <TextBlock Text="{Binding LobbyCode}" Margin="8,0,0,0"
                                   FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                                   FontSize="{x:Static styles:FontTypography.SectionTitleFontSize}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                               FontFamily="{x:Static styles:FontTypography.BodyFontFamily}">
                        <Run Text="{x:Static language:Resources.Lobby_PlayerLimit}" />
                        <Run Text="{Binding MaximumLobbyPlayerCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="StartGameButton"
                            Content="{x:Static language:Resources.Lobby_StartGameButton}"
                            Width="180" Height="44"
                            Margin="0,0,12,0"
                            Background="{x:Static styles:ColorPalette.SuccessButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.PureWhiteBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            BorderThickness="0"
                            IsEnabled="{Binding CanStartCurrentLobby, Mode=OneWay}"
                            Command="{Binding StartGameCommand}" />

                    <Button x:Name="SettingsButton"
                            Content="{x:Static language:Resources.Lobby_SettingsButton}"
                            Width="230" Height="44"
                            Background="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}"
                            Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                            FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                            FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                            BorderThickness="0"
                            IsEnabled="{Binding CanEditCurrentLobby}"
                            Command="{Binding SettingsCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                    BorderThickness="4"
                    Margin="12,12,12,12"
                    Padding="0"
                    Background="{x:Static styles:ColorPalette.LobbyMatchSurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <ItemsControl x:Name="PlayersItemsControl"
                                  ItemsSource="{Binding Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                        BorderThickness="3"
                                        Margin="0"
                                        MinHeight="84" Padding="16,10"
                                        Background="{x:Static styles:ColorPalette.LobbyMatchSurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <ContentControl ContentTemplate="{StaticResource LobbyAvatarTemplate}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Username}"
                                                       Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                       FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="&#x22EE;" Width="28" Height="30" Margin="8,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    FontSize="20" Click="OnPlayerActionsButtonClick"
                                                    ToolTip="{x:Static language:Resources.Lobby_PlayerActions}"
                                                    Visibility="{Binding CanBeKickedByCurrentHost,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                     RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="{x:Static language:Resources.Lobby_KickPlayer}"
                                                                  Command="{Binding KickPlayerCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <TextBlock Text="&#x1F451;"
                                                       FontSize="{x:Static styles:FontTypography.ActionButtonFontSize}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding IsHost,
                                                           Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="ReadyButton"
                                                    Width="96" Height="36" Margin="8,0,0,0"
                                                    Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                                    BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                                    BorderThickness="2"
                                                    FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                    FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                                    Visibility="{Binding IsCurrentPlayer,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ToggleReadyCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content"
                                                            Value="{x:Static language:Resources.Lobby_NotReadyButton}" />
                                                        <Setter Property="Background"
                                                            Value="{x:Static styles:ColorPalette.PrimaryButtonBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Content"
                                                                    Value="{x:Static language:Resources.Lobby_ReadyButton}" />
                                                                <Setter Property="Background"
                                                                    Value="{x:Static styles:ColorPalette.SuccessButtonBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <TextBlock VerticalAlignment="Center"
                                                       Margin="8,0,8,0"
                                                       FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                                       FontSize="{x:Static styles:FontTypography.CaptionFontSize}"
                                                       Foreground="{x:Static styles:ColorPalette.DarkTextBrush}"
                                                       Visibility="{Binding IsOtherPlayer,
                                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                            Value="{x:Static language:Resources.Lobby_NotReadyButton}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Text"
                                                                    Value="{x:Static language:Resources.Lobby_ReadyButton}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding VacantLobbyPlayerSlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="84" Padding="16,10"
                                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                        BorderThickness="3"
                                        Background="{x:Static styles:ColorPalette.LobbyMatchSurfaceBrush}">
                                    <Grid>
                                        <ContentControl ContentTemplate="{StaticResource LobbyAvatarTemplate}"
                                                        HorizontalAlignment="Left" />
                                        <Canvas Width="44" Height="44" HorizontalAlignment="Right">
                                            <Ellipse Width="44" Height="44" StrokeThickness="3"
                                                     Stroke="{x:Static styles:ColorPalette.PureBlackBrush}" />
                                            <Path Data="M 22 10 L 22 34 M 10 22 L 34 22" StrokeThickness="3"
                                                  Stroke="{x:Static styles:ColorPalette.PureBlackBrush}" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="132,180,12,0">
            <TextBlock Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                       Visibility="{Binding HasLobbyHostChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Run Text="{x:Static language:Resources.Lobby_HostChanged}" />
                <Run Text="{Binding CurrentLobbyHostUsername, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{x:Static language:Resources.Lobby_ConnectionLost}" TextWrapping="Wrap" MaxWidth="700"
                       Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                       Visibility="{Binding HasLobbyConnectionFailure,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <ToggleButton x:Name="LobbyChatToggleButton" Grid.Column="0"
                      Width="56" Height="56" Margin="0,0,10,12"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Panel.ZIndex="2" Cursor="Hand"
                      AutomationProperties.Name="{x:Static language:Resources.Chat_Title}"
                      ToolTip="{x:Static language:Resources.Chat_Title}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{x:Static styles:ColorPalette.PureBlackBrush}" CornerRadius="28">
                        <Canvas Width="34" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 3 2 L 31 2 L 31 23 L 20 23 L 12 29 L 12 23 L 3 23 Z"
                                  Stroke="{x:Static styles:ColorPalette.PureWhiteBrush}" StrokeThickness="2" />
                            <Ellipse Width="3" Height="3" Canvas.Left="9" Canvas.Top="11"
                                     Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
                            <Ellipse Width="3" Height="3" Canvas.Left="16" Canvas.Top="11"
                                     Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
                            <Ellipse Width="3" Height="3" Canvas.Left="23" Canvas.Top="11"
                                     Fill="{x:Static styles:ColorPalette.PureWhiteBrush}" />
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Border x:Name="LobbyChatPanel" Grid.Column="0" Panel.ZIndex="1"
                Width="485" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,0,72" Padding="34,10,34,12"
                Background="{x:Static styles:ColorPalette.LobbyMatchSurfaceBrush}"
                BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}" BorderThickness="3"
                Visibility="{Binding IsChecked, ElementName=LobbyChatToggleButton,
                    Converter={StaticResource BooleanToVisibilityConverter}}"
                DataContext="{Binding Chat}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static language:Resources.Chat_Title}" Margin="0,0,0,8"
                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                           FontFamily="{x:Static styles:FontTypography.TitleFontFamily}"
                           FontSize="{x:Static styles:FontTypography.ProfileTitleFontSize}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding ChatMessages}" Padding="10"
                         Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                         BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}" BorderThickness="3"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                         FontSize="{x:Static styles:FontTypography.FormLabelFontSize}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}"
                                    BorderThickness="3" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl ContentTemplate="{StaticResource LobbyAvatarTemplate}"
                                                    VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding SenderUsername}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,4"
                           Foreground="{x:Static styles:ColorPalette.MainTitleTextBrush}"
                           Text="{Binding ChatSubmissionFeedbackText}" />
                <Border Grid.Row="3" Background="{x:Static styles:ColorPalette.PureWhiteBrush}"
                        BorderBrush="{x:Static styles:ColorPalette.PureBlackBrush}" BorderThickness="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LobbyChatMessageInput" BorderThickness="0" Padding="8,6"
                                 VerticalContentAlignment="Center" MinHeight="40"
                                 FontFamily="{x:Static styles:FontTypography.BodyFontFamily}"
                                 FontSize="{x:Static styles:FontTypography.FormLabelFontSize}"
                                 Text="{Binding DraftChatMessageText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRegisteredAccountChatAvailable}"
                                 AutomationProperties.Name="{x:Static language:Resources.Chat_MessageInput}"
                                 ToolTip="{x:Static language:Resources.Chat_RegisteredAccountsOnly}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendChatMessageCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock IsHitTestVisible="False" Margin="8,0" VerticalAlignment="Center"
                                   Text="{x:Static language:Resources.Chat_MessageInput}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DraftChatMessageText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Command="{Binding SendChatMessageCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                AutomationProperties.Name="{x:Static language:Resources.Chat_Send}"
                                ToolTip="{x:Static language:Resources.Chat_Send}">
                            <Path Width="28" Height="28" Stretch="Uniform"
                                  Data="M 2 2 L 30 16 L 2 30 L 7 16 Z M 7 16 L 30 16"
                                  Stroke="{x:Static styles:ColorPalette.PureBlackBrush}" StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Friends Sidebar Component -->
        <local:FriendsView Grid.Column="1" IsInLobby="True" />
    </Grid>
</Page>
