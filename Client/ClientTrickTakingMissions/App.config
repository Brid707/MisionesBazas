<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="View.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="ProfileImageEndpointAddress" value="net.tcp://localhost:8090/ProfileImageService" />
  </appSettings>
  <userSettings>
    <View.Properties.Settings>
      <setting name="LanguageCode" serializeAs="String">
        <value>es-MX</value>
      </setting>
    </View.Properties.Settings>
  </userSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="PlayerProfileBinding" openTimeout="00:00:05" closeTimeout="00:00:02"
                 sendTimeout="00:00:15" receiveTimeout="00:01:00" maxReceivedMessageSize="8192">
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>

        <binding name="NetTcpBinding_IUserLogin">
          <security mode="None">
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_ILobbyService">
          <security mode="None">
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IAccountManagementService">
          <security mode="None">
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IFriendshipService">
          <security mode="None">
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IFriendsRequestService">
          <security mode="None">
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8090/PlayerProfileService"
                binding="netTcpBinding" bindingConfiguration="PlayerProfileBinding"
                contract="Model.PlayerProfileService.IPlayerProfileService" name="PlayerProfileEndpoint" />

      <endpoint address="net.tcp://localhost:8090/UserLoginService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IUserLogin"
        contract="Model.GameServices.IUserLogin" name="NetTcpBinding_IUserLogin">
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/LobbyService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ILobbyService"
        contract="Model.GameServices.ILobbyService" name="NetTcpBinding_ILobbyService">
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/AccountManagementService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IAccountManagementService"
        contract="Model.Services.IAccountManagementServiceChannel" name="NetTcpBinding_IAccountManagementService">
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/FriendshipService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IFriendshipService"
        contract="IFriendShipService.IFriendshipService" name="NetTcpBinding_IFriendshipService">
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/FriendsRequestService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IFriendsRequestService"
        contract="IFriendsRequestService.IFriendsRequestService" name="NetTcpBinding_IFriendsRequestService">
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>
